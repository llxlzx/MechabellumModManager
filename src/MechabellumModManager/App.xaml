<Application x:Class="MechabellumModManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Dark industrial mech palette: charcoal steel + amber accent -->
            <Color x:Key="BgDeepColor">#FF0E1114</Color>
            <Color x:Key="BgPanelColor">#FF161B20</Color>
            <Color x:Key="BgElevatedColor">#FF1E262E</Color>
            <Color x:Key="SteelColor">#FF2A343F</Color>
            <Color x:Key="SteelEdgeColor">#FF3D4A57</Color>
            <Color x:Key="TextPrimaryColor">#FFE6EAF0</Color>
            <Color x:Key="TextMutedColor">#FF8A96A3</Color>
            <Color x:Key="AccentAmberColor">#FFC8892E</Color>
            <Color x:Key="AccentAmberHotColor">#FFE0A84A</Color>
            <Color x:Key="DangerColor">#FFB84A3A</Color>

            <SolidColorBrush x:Key="BgDeepBrush" Color="{StaticResource BgDeepColor}" />
            <SolidColorBrush x:Key="BgPanelBrush" Color="{StaticResource BgPanelColor}" />
            <SolidColorBrush x:Key="BgElevatedBrush" Color="{StaticResource BgElevatedColor}" />
            <SolidColorBrush x:Key="SteelBrush" Color="{StaticResource SteelColor}" />
            <SolidColorBrush x:Key="SteelEdgeBrush" Color="{StaticResource SteelEdgeColor}" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
            <SolidColorBrush x:Key="AccentAmberBrush" Color="{StaticResource AccentAmberColor}" />
            <SolidColorBrush x:Key="AccentAmberHotBrush" Color="{StaticResource AccentAmberHotColor}" />
            <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />

            <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF0A0C0E" Offset="0" />
                <GradientStop Color="#FF141A20" Offset="0.45" />
                <GradientStop Color="#FF0F1318" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="HeaderBarBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FF1A222A" Offset="0" />
                <GradientStop Color="#FF12171C" Offset="1" />
            </LinearGradientBrush>

            <FontFamily x:Key="AppFontFamily">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, sans-serif</FontFamily>
            <FontFamily x:Key="AppDisplayFontFamily">Segoe UI Variable Display, Segoe UI Semibold, Microsoft YaHei UI, sans-serif</FontFamily>

            <Style TargetType="Window">
                <Setter Property="Background" Value="{StaticResource WindowBackgroundBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style x:Key="ShellTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppDisplayFontFamily}" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            </Style>

            <Style x:Key="ShellSubtitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            </Style>

            <Style x:Key="AccentBarStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource AccentAmberBrush}" />
                <Setter Property="Width" Value="3" />
                <Setter Property="CornerRadius" Value="1" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
