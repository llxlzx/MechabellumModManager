                                                    ElementStyle="{StaticResource GridNameTextStyle}"
                                                    Width="2.6*"
                                                    MinWidth="220"
                                                    MaxWidth="420"
                                                    SortDirection="Ascending" />
                                <DataGridTextColumn Header="{Binding Data.Ui.ColumnCategory, Source={StaticResource Proxy}}"
                                                    Binding="{Binding EffectiveCategoryDisplay}"
                                                    IsReadOnly="True"
                                                    ElementStyle="{StaticResource GridCellTextStyle}"
                                                    Width="1.15*"
                                                    MinWidth="120" />
                                <DataGridTextColumn Header="{Binding Data.Ui.ColumnTag, Source={StaticResource Proxy}}"
                                                    Binding="{Binding EffectiveTagsText}"
                                                    IsReadOnly="True"
                                                    ElementStyle="{StaticResource GridCellTextStyle}"
                                                    Width="1.35*"
                                                    MinWidth="130" />
                                <DataGridTextColumn Header="{Binding Data.Ui.ColumnAuthor, Source={StaticResource Proxy}}"
                                                    Binding="{Binding Author}"
                                                    IsReadOnly="True"
                                                    ElementStyle="{StaticResource GridCellTextStyle}"
                                                    Width="0.9*"
                                                    MinWidth="90" />
                                <DataGridTextColumn Header="{Binding Data.Ui.ColumnType, Source={StaticResource Proxy}}"
                                                    Binding="{Binding TypeLabel}"
                                                    IsReadOnly="True"
                                                    ElementStyle="{StaticResource GridCellTextStyle}"
                                                    Width="100"
                                                    MinWidth="88" />
                                <DataGridTextColumn Header="{Binding Data.Ui.ColumnVersion, Source={StaticResource Proxy}}"
                                                    Binding="{Binding Version}"
                                                    IsReadOnly="True"
                                                    ElementStyle="{StaticResource GridCellTextStyle}"
                                                    Width="80"
                                                    MinWidth="72" />
                                <DataGridTemplateColumn Header="{Binding Data.Ui.ColumnStatus, Source={StaticResource Proxy}}"
                                                        Width="128"
                                                        MinWidth="112"
                                                        SortMemberPath="UpdateStatusText">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding UpdateStatusText}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding UpdateStatusText}"
                                                       VerticalAlignment="Center"
                                                       FontSize="14">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource AccentAmberBrush}" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsStaleDuplicate}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{Binding Data.Ui.ActionUpdate, Source={StaticResource Proxy}}"
                                                        Width="88"
                                                        MinWidth="80"
                                                        CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding DataContext.Ui.ActionUpdate, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Command="{Binding DataContext.UpdateModCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}"
                                                    Padding="10,4"
                                                    MinWidth="72"
                                                    MinHeight="32"
                                                    HorizontalAlignment="Left"
                                                    FontSize="14"
                                                    Style="{StaticResource AccentButtonStyle}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{Binding Data.Ui.ColumnRisk, Source={StaticResource Proxy}}"
                                                        Width="84"
                                                        MinWidth="76"
                                                        SortMemberPath="LogicFrameGradeLabel">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding LogicFrameGradeLabel}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding LogicFrameGradeLabel}"
                                                       VerticalAlignment="Center"
                                                       FontSize="14">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource RiskLowBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Package.LogicFrameGrade}" Value="Medium">
                                                                <Setter Property="Foreground" Value="{StaticResource RiskMediumBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Package.LogicFrameGrade}" Value="High">
                                                                <Setter Property="Foreground" Value="{StaticResource RiskHighBrush}" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Package.LogicFrameGrade}" Value="Unchecked">
                                                                <Setter Property="Foreground" Value="{StaticResource RiskUncheckedBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{Binding Data.Ui.ColumnLoader, Source={StaticResource Proxy}}"
                                                        Width="104"
                                                        MinWidth="88"
                                                        SortMemberPath="RequiredMelonLoaderVersion">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding RequiredMelonLoaderVersion}"
                                                       FontSize="14"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding VersionWarningHint}"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RequiredMelonLoaderVersion}" Value="{x:Null}">
                                                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RequiredMelonLoaderVersion}" Value="">
                                                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="" Width="72" MinWidth="64" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding DataContext.Ui.ActionDelete, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Command="{Binding DataContext.DeleteModCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource DeleteRowButtonStyle}"
                                                    ToolTip="{Binding DataContext.Ui.TipDeleteFromLibrary, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="{Binding Ui.LibraryEmptyHint}"
                                   Style="{StaticResource EmptyStateStyle}"
                                   Visibility="{Binding IsLibraryEmpty, Converter={StaticResource BoolToVis}}" />
                        </Grid>

                        <Border Grid.Row="2"
                                Margin="0,12,0,0"
                                Padding="0,10,0,0"
                                MaxHeight="160"
                                BorderBrush="{StaticResource SteelEdgeBrush}"
                                BorderThickness="0,1,0,0">
                            <StackPanel>
                                <Border Margin="0,0,0,10"
                                        Visibility="{Binding SelectedLibraryMod, Converter={StaticResource NullToVis}}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right"
                                                    VerticalAlignment="Top"
                                                    Margin="8,0,0,0">
                                            <Button Command="{Binding ReportLibraryModCommand}"
                                                    MinWidth="72"
                                                    Padding="10,6"
                                                    MinHeight="30"
                                                    FontSize="13"
                                                    Margin="0,0,0,6"
                                                    Style="{StaticResource GhostButtonStyle}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Width="14" Height="14" Margin="0,0,6,0"
                                                          Stretch="Uniform"
                                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          Data="{StaticResource IconFlagGeometry}" />
                                                    <TextBlock Text="{Binding Ui.Report}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Content="{Binding Ui.ActionCollapseDetail}"
                                                    Command="{Binding ClearLibraryModSelectionCommand}"
                                                    MinWidth="72"
                                                    Padding="10,6"
                                                    MinHeight="30"
                                                    FontSize="13"
                                                    Style="{StaticResource GhostButtonStyle}" />
                                        </StackPanel>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      MaxHeight="140">
                                            <DockPanel>
                                                <theme:ModePlate DockPanel.Dock="Left"
                                                                 Width="168"
                                                                 Height="108"
                                                                 Margin="0,0,12,0"
                                                                 Cursor="Hand"
                                                                 ToolTip="{Binding Ui.PreviewImageHint}">
                                                    <Image Source="{Binding SelectedLibraryMod.PreviewImage}"
                                                           Stretch="Uniform"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           MouseLeftButtonUp="ModPreviewImage_Click" />
                                                </theme:ModePlate>
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold"
                                                               FontSize="13"
                                                               TextWrapping="Wrap"
                                                               Foreground="{StaticResource TextPrimaryBrush}">
                                                        <Run Text="{Binding Ui.LabelName, Mode=OneWay}" />
                                                        <Run Text="：" />
                                                        <Run Text="{Binding SelectedLibraryMod.DisplayName, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Margin="0,4,0,0"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               FontSize="13"
                                                               TextWrapping="Wrap">
                                                        <Run Text="{Binding Ui.LabelAuthor, Mode=OneWay}" />
                                                        <Run Text="：" />
                                                        <Run Text="{Binding SelectedLibraryMod.Author, Mode=OneWay}" />
                                                        <Run Text="  ·  " />
                                                        <Run Text="{Binding Ui.LabelVersion, Mode=OneWay}" />
                                                        <Run Text="：" />
                                                        <Run Text="{Binding SelectedLibraryMod.Version, Mode=OneWay}" />
                                                        <Run Text="  ·  " />
                                                        <Run Text="{Binding Ui.LabelUpdated, Mode=OneWay}" />
                                                        <Run Text="：" />
                                                        <Run Text="{Binding SelectedLibraryMod.CatalogUpdatedAt, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Margin="0,6,0,0"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               FontSize="13"
                                                               TextWrapping="Wrap">
                                                        <Run Text="{Binding Ui.LabelSummary, Mode=OneWay}" />
                                                        <Run Text="：" />
                                                        <Run Text="{Binding SelectedLibraryMod.Summary, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Margin="0,6,0,0"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               FontSize="13"
                                                               TextWrapping="Wrap"
                                                               Visibility="{Binding SelectedLibraryMod.EffectiveTagsText, Converter={StaticResource NonEmptyVis}}">
                                                        <Run Text="{Binding Ui.TagsLabel, Mode=OneWay}" />
                                                        <Run Text="：" />
                                                        <Run Text="{Binding SelectedLibraryMod.EffectiveTagsText, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </DockPanel>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>
                                <TextBlock Text="{Binding DirtyHint}"
                                           Foreground="{StaticResource AccentTealBrush}"
                                           FontSize="13" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            </Grid><!-- ContentPagesHost -->

            <StackPanel Grid.Row="2" Margin="12,0,12,4">
                <Border Background="#FF241C12"
                        BorderBrush="{StaticResource DangerBrush}"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="12,8"
                        Margin="0,0,0,8"
                        Visibility="{Binding MissingEnabledPackagesWarning, Converter={StaticResource NonEmptyVis}}">
                    <TextBlock Text="{Binding MissingEnabledPackagesWarning}"
                               Foreground="{StaticResource AccentAmberHotBrush}"
                               TextWrapping="Wrap"
                               FontSize="13" />
                </Border>
                <Border Background="#FF241C12"
                        BorderBrush="{StaticResource WarnBrush}"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="12,8"
                        Visibility="{Binding LoaderVersionWarning, Converter={StaticResource NonEmptyVis}}">
                    <TextBlock Text="{Binding LoaderVersionWarning}"
                               Foreground="{StaticResource AccentAmberHotBrush}"
                               TextWrapping="Wrap"
                               FontSize="13" />
                </Border>
                <Border Background="#FF241C12"
                        BorderBrush="{StaticResource WarnBrush}"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="12,8"
                        Margin="0,8,0,0"
                        Visibility="{Binding FirstAssemblyWarning, Converter={StaticResource NonEmptyVis}}">
                    <TextBlock Text="{Binding FirstAssemblyWarning}"
                               Foreground="{StaticResource AccentAmberHotBrush}"
                               TextWrapping="Wrap"
                               FontSize="13" />
                </Border>
            </StackPanel>

            <Border Grid.Row="3"
                    Margin="12,0,12,4"
                    Background="#FF161210"
                    BorderBrush="#FF8C4A3A"
                    BorderThickness="3,0,0,0"
                    Padding="12,8">
                <TextBlock Text="{Binding RiskBanner}"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="14"
                           VerticalAlignment="Center" />
            </Border>

            <Border Grid.Row="4"
                    Margin="12,4,12,10"
                    Style="{StaticResource PanelChromeStyle}"
                    Background="#EE0E1114"
                    Padding="10,8"
                    x:Name="LogPanel">
                <DockPanel LastChildFill="True">
                    <!-- Header: title + export + expand/collapse -->
                    <DockPanel DockPanel.Dock="Top" LastChildFill="True" Margin="0,0,0,0">
                        <Button Content="{Binding Ui.ExportDiagnosticsButton}"
                                Command="{Binding ExportDiagnosticsCommand}"
                                DockPanel.Dock="Right"
                                MinWidth="88"
                                Margin="8,0,0,0"
                                Padding="10,2"
                                VerticalAlignment="Center"
                                Style="{StaticResource GhostButtonStyle}" />
                        <Button Command="{Binding ToggleLogPanelCommand}"
                                Padding="4,2"
                                HorizontalContentAlignment="Stretch"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="MinHeight" Value="28" />
                                    <Setter Property="Padding" Value="4,2" />
                                </Style>
                            </Button.Style>
                            <DockPanel LastChildFill="True">
                                <Border Style="{StaticResource AccentBarStyle}"
                                        Height="12"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        DockPanel.Dock="Left" />
                                <Grid DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Ui.LogExpand}"
                                               Foreground="{StaticResource AccentAmberHotBrush}"
                                               FontSize="13">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLogExpanded}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Ui.LogCollapse}"
                                               Foreground="{StaticResource AccentAmberHotBrush}"
                                               FontSize="13"
                                               Visibility="{Binding IsLogExpanded, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                                <TextBlock Text="{Binding Ui.SyncLog}"
                                           Style="{StaticResource SectionLabelStyle}"
                                           Margin="0"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                        </Button>
                    </DockPanel>

                    <!-- Collapsed: one-line preview -->
                        <TextBlock Margin="11,4,0,0"
                               FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI"
                               FontSize="14"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="{Binding LatestLogLine}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               MaxHeight="18"
                               ToolTip="{Binding LatestLogLine}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLogExpanded}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Expanded: large scrollable log -->
                    <Border Margin="0,8,0,0"
                            Background="#990A0D10"
                            BorderBrush="{StaticResource SteelBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="10,8"
                            MinHeight="200"
                            MaxHeight="360"
                            Visibility="{Binding IsLogExpanded, Converter={StaticResource BoolToVis}}">
                        <TextBox Text="{Binding LogText, Mode=OneWay}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI"
                                 FontSize="14"
                                 VerticalContentAlignment="Top"
                                 Foreground="{StaticResource TextBodyBrush}" />
                    </Border>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
