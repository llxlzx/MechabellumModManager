<Window x:Class="MechabellumModManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:MechabellumModManager.Converters"
        xmlns:helpers="clr-namespace:MechabellumModManager.Helpers"
        xmlns:theme="clr-namespace:MechabellumModManager.Themes"
        mc:Ignorable="d"
        Title="钢铁指挥官 Mod 管理器"
        Height="740"
        Width="1200"
        MinHeight="600"
        MinWidth="780"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}">
    <Window.Resources>
        <helpers:BindingProxy x:Key="Proxy" Data="{Binding}" />
        <conv:NonEmptyStringToVisibilityConverter x:Key="NonEmptyVis" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
    </Window.Resources>

    <Grid>
        <!-- Atmosphere (non-interactive) -->
        <Grid IsHitTestVisible="False">
            <Rectangle Fill="{StaticResource WindowBackgroundBrush}" />
            <Rectangle Fill="{StaticResource GridOverlayBrush}" Opacity="0.55" />
        </Grid>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top: always two rows — brand/status, then profile/actions -->
            <Border Grid.Row="0"
                    Background="{StaticResource HeaderBarBrush}"
                    BorderBrush="{StaticResource SteelEdgeBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Row 1: brand + status -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="120" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <theme:ModePlate Width="42"
                                             Height="42"
                                             Margin="0,0,12,0">
                                <Image x:Name="BrandImage"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </theme:ModePlate>
                            <Border Style="{StaticResource AccentBarStyle}"
                                    Height="34"
                                    Margin="0,0,12,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="钢铁指挥官"
                                           Style="{StaticResource ShellTitleStyle}" />
                                <TextBlock Text="Mod 管理器 · Mechabellum"
                                           Style="{StaticResource ShellSubtitleStyle}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Background="{StaticResource BgPanelBrush}"
                                BorderThickness="1"
                                Padding="12,7"
                                theme:ChamferClip.Size="6"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Stretch">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{StaticResource SteelEdgeBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowReadyAccent}" Value="False">
                                            <Setter Property="BorderBrush" Value="{StaticResource WarnBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsAwaitingGameProcess}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource SteelEdgeBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ShowReadyAccent}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentTealBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding StatusKindLabel}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAwaitingGameProcess}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ShowReadyAccent}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentAmberHotBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding StatusDetail}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"
                                           ToolTip="{Binding StatusDetail}" />
                                <Button Grid.Column="2"
                                        MinWidth="108"
                                        Padding="10,4"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Command="{Binding InstallMelonLoaderCommand}"
                                        Content="{Binding Ui.InstallMelonLoader}"
                                        Visibility="{Binding NeedsMelonLoaderInstall, Converter={StaticResource BoolToVis}}"
                                        ToolTip="{Binding Ui.InstallMelonLoaderTip}" />
                            </Grid>
                            <TextBlock Text="{Binding DiagnosisTitle}"
                                       ToolTip="{Binding DiagnosisTooltip}"
                                       Foreground="{StaticResource WarnBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap"
                                       Margin="0,4,0,0"
                                       FontSize="12"
                                       Visibility="{Binding DiagnosisTitle, Converter={StaticResource NonEmptyVis}}" />
                            <TextBlock Text="{Binding DeployBlockedReason}"
                                       Visibility="{Binding ShowDeployBlockedReason, Converter={StaticResource BoolToVis}}"
                                       Foreground="{StaticResource WarnBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"
                                       FontSize="12" />
                            <StackPanel Margin="0,8,0,0"
                                        Visibility="{Binding HasCurrentTask, Converter={StaticResource BoolToVis}}">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding TaskTitle}"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding TaskPercentLabel}"
                                               FontSize="12"
                                               Margin="8,0,0,0"
                                               Visibility="{Binding ShowTaskPercent, Converter={StaticResource BoolToVis}}"
                                               Foreground="{StaticResource AccentAmberHotBrush}" />
                                </Grid>
                                <TextBlock Text="{Binding TaskMessage}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           ToolTip="{Binding TaskMessage}"
                                           Margin="0,0,0,4" />
                                <ProgressBar Height="6"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding TaskProgressValue, Mode=OneWay}"
                                             IsIndeterminate="{Binding IsTaskIndeterminate, Mode=OneWay}"
                                             Background="{StaticResource BgElevatedBrush}"
                                             Foreground="{StaticResource AccentAmberBrush}"
                                             BorderThickness="0" />
                            </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Row 2: profile left, actions wrap right -->
                    <Border Grid.Row="1"
                            Margin="0,10,0,0"
                            Padding="0,10,0,0"
                            BorderBrush="{StaticResource SteelEdgeBrush}"
                            BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="0,0,12,0">
                                <TextBlock Text="{Binding Ui.CurrentProfile}"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Margin="0,0,8,0" />
                                <ComboBox MinWidth="120"
                                          Width="160"
                                          ItemsSource="{Binding Profiles}"
                                          SelectedItem="{Binding SelectedProfile}"
                                          DisplayMemberPath="Name"
                                          VerticalAlignment="Center" />
                            </StackPanel>

                            <DockPanel Grid.Column="1" LastChildFill="True">
                                <StackPanel DockPanel.Dock="Left"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button Command="{Binding ShowLibraryPageCommand}"
                                            ToolTip="{Binding Ui.NavLibraryTip}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLibraryPage}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentAmberBrush}" />
                                                        <Setter Property="Foreground" Value="{StaticResource AccentAmberBrush}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Ui.ModLibrary}" VerticalAlignment="Center" />
                                                <Border Margin="6,0,0,0"
                                                        Padding="6,1"
                                                        Background="{StaticResource BgDeepBrush}"
                                                        BorderBrush="{StaticResource SteelEdgeBrush}"
                                                        BorderThickness="1"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding HasOutdatedMods, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding OutdatedCount}"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Ui.NavNoteLibrary}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontSize" Value="13" />
                                                        <Setter Property="FontWeight" Value="Normal" />
                                                        <Setter Property="Height" Value="16" />
                                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                        <Setter Property="Opacity" Value="0" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLibraryPage}" Value="True">
                                                                <Setter Property="Opacity" Value="1" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Border Height="2" Width="36" HorizontalAlignment="Left" Margin="0,3,0,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource AccentAmberBrush}" />
                                                        <Setter Property="Opacity" Value="0" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLibraryPage}" Value="True">
                                                                <Setter Property="Opacity" Value="1" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding ShowCatalogPageCommand}"
                                            ToolTip="{Binding Ui.NavWorkshopTip}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCatalogPage}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentAmberBrush}" />
                                                        <Setter Property="Foreground" Value="{StaticResource AccentAmberBrush}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Ui.BrowseMods}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Ui.NavNoteWorkshop}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontSize" Value="13" />
                                                        <Setter Property="FontWeight" Value="Normal" />
                                                        <Setter Property="Height" Value="16" />
                                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                        <Setter Property="Opacity" Value="0" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCatalogPage}" Value="True">
                                                                <Setter Property="Opacity" Value="1" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Border Height="2" Width="36" HorizontalAlignment="Left" Margin="0,3,0,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource AccentAmberBrush}" />
                                                        <Setter Property="Opacity" Value="0" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCatalogPage}" Value="True">
                                                                <Setter Property="Opacity" Value="1" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding ShowGuidePageCommand}"
                                            ToolTip="{Binding Ui.NavNoteGuide}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsGuidePage}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentAmberBrush}" />
                                                        <Setter Property="Foreground" Value="{StaticResource AccentAmberBrush}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Ui.GuideNav}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Ui.NavNoteGuide}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontSize" Value="13" />
                                                        <Setter Property="FontWeight" Value="Normal" />
                                                        <Setter Property="Height" Value="16" />
                                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                        <Setter Property="Opacity" Value="0" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsGuidePage}" Value="True">
                                                                <Setter Property="Opacity" Value="1" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Border Height="2" Width="36" HorizontalAlignment="Left" Margin="0,3,0,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource AccentAmberBrush}" />
                                                        <Setter Property="Opacity" Value="0" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsGuidePage}" Value="True">
                                                                <Setter Property="Opacity" Value="1" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding ShowBranchPageCommand}"
                                            ToolTip="{Binding Ui.NavBranchTip}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBranchPage}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentAmberBrush}" />
                                                        <Setter Property="Foreground" Value="{StaticResource AccentAmberBrush}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Ui.NavBranch}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Ui.NavNoteBranch}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontSize" Value="13" />
                                                        <Setter Property="FontWeight" Value="Normal" />
                                                        <Setter Property="Height" Value="16" />
                                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                        <Setter Property="Opacity" Value="0" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsBranchPage}" Value="True">
                                                                <Setter Property="Opacity" Value="1" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Border Height="2" Width="36" HorizontalAlignment="Left" Margin="0,3,0,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource AccentAmberBrush}" />
                                                        <Setter Property="Opacity" Value="0" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsBranchPage}" Value="True">
                                                                <Setter Property="Opacity" Value="1" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <WrapPanel Orientation="Horizontal"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center">
                                    <Button Content="{Binding Ui.CheckUpdates}"
                                            Command="{Binding CheckForUpdatesCommand}"
                                            Style="{StaticResource TextLinkButtonStyle}"
                                            Margin="0,0,4,0" />
                                    <Button Command="{Binding SubmitModCommand}"
                                            Style="{StaticResource TextLinkButtonStyle}"
                                            Margin="0,0,4,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="14" Height="14" Margin="0,0,6,0"
                                                  Stretch="Uniform"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  Data="{StaticResource IconUploadGeometry}" />
                                            <TextBlock Text="{Binding Ui.SubmitMod}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding DirectUploadCommand}"
                                            Style="{StaticResource TextLinkButtonStyle}"
                                            Margin="0,0,4,0">
                                        <TextBlock Text="{Binding Ui.DirectUpload}" VerticalAlignment="Center" />
                                    </Button>
                                    <Button Command="{Binding ShowSettingsPageCommand}"
                                            Margin="0,0,10,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource TextLinkButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSettingsPage}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentAmberBrush}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="14" Height="14" Margin="0,0,6,0"
                                                  Stretch="Uniform"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  Data="{StaticResource IconGearGeometry}" />
                                            <TextBlock Text="{Binding Ui.Settings}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding ApplyAndLaunchCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            MinWidth="108"
                                            ToolTip="{Binding DeployBlockedReason}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="14" Height="14" Margin="0,0,6,0"
                                                  Stretch="Uniform"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  Data="{StaticResource IconPlayGeometry}" />
                                            <TextBlock Text="{Binding Ui.ApplyAndLaunch}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </DockPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Content pages host (exclusive: settings / catalog / library) -->
            <Grid Grid.Row="1" x:Name="ContentPagesHost">

            <Border Style="{StaticResource PanelChromeStyle}"
                    Padding="14,10"
                    Margin="12,8,12,8"
                    Visibility="{Binding IsGuidePage, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                        <StackPanel.Resources>
                            <Style x:Key="GuideNoteBorder" TargetType="Border">
                                <Setter Property="Background" Value="#331C3040" />
                                <Setter Property="BorderBrush" Value="{StaticResource AccentAmberBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="CornerRadius" Value="3" />
                                <Setter Property="Padding" Value="10,8" />
                                <Setter Property="Margin" Value="0,2,0,10" />
                            </Style>
                        </StackPanel.Resources>
                        <CheckBox IsChecked="{Binding SkipGuideOnStartup, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  HorizontalAlignment="Left"
                                  Margin="0,0,0,14"
                                  FontSize="14">
                            <TextBlock>
                                <Run Text="下次启动不再打开本页" FontWeight="SemiBold" />
                                <Run Text="  ·  Don't open this page on startup"
                                     Foreground="{StaticResource TextMutedBrush}" />
                            </TextBlock>
                        </CheckBox>
                        <TextBlock Text="{Binding Ui.GuideIntro}" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,14" />

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,6">
                            <Border Width="22" Height="22" CornerRadius="11"
                                    Background="{StaticResource AccentAmberBrush}"
                                    Margin="0,1,8,0" VerticalAlignment="Top">
                                <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextOnAccentBrush}" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="先选界面语言" FontWeight="SemiBold" />
                                <TextBlock Text="Choose the interface language" FontSize="13"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="在下面直接选。选好后，本页和整个管理器会立刻换成这种语言。也可以选「跟随系统」。"
                                   TextWrapping="Wrap" Margin="30,0,0,2" />
                        <TextBlock Text="Pick it below. This page and the whole manager switch immediately. You can also choose Follow system."
                                   TextWrapping="Wrap" FontSize="13"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="30,0,0,8" />
                        <DockPanel Margin="30,0,0,12">
                            <TextBlock Text="语言 / Language"
                                       Margin="0,0,10,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       DockPanel.Dock="Left" />
                            <ComboBox Width="180"
                                      HorizontalAlignment="Left"
                                      ItemsSource="{Binding LanguageOptions}"
                                      SelectedValue="{Binding SelectedUiLanguageCode}"
                                      SelectedValuePath="Code"
                                      DisplayMemberPath="Label"
                                      VerticalAlignment="Center" />
                        </DockPanel>

                        <TextBlock Text="{Binding Ui.GuideLoaderTitle}" FontWeight="SemiBold" Margin="0,8,0,4" />
                        <TextBlock Text="{Binding Ui.GuideLoaderBody}" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <Border Style="{StaticResource GuideNoteBorder}">
                            <DockPanel>
                                <Viewbox Width="16" Height="16" Margin="0,1,10,0" DockPanel.Dock="Left" VerticalAlignment="Top">
                                    <Canvas Width="16" Height="16">
                                        <Path Fill="{StaticResource AccentAmberHotBrush}" Data="{StaticResource IconNoticeGeometry}" />
                                        <Path Fill="{StaticResource TextOnAccentBrush}" Data="{StaticResource IconNoticeMarkGeometry}" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="{Binding Ui.GuideNoteMelon}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>

                        <TextBlock Text="{Binding Ui.GuidePathTitle}" FontWeight="SemiBold" Margin="0,8,0,4" />
                        <TextBlock Text="{Binding Ui.GuidePathBody}" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <Button Content="{Binding Ui.GuideOpenSettings}" Command="{Binding ShowSettingsPageCommand}" HorizontalAlignment="Left" Margin="0,0,0,8" Style="{StaticResource GhostButtonStyle}" />

                        <TextBlock Text="{Binding Ui.GuideBrowseTitle}" FontWeight="SemiBold" Margin="0,8,0,4" />
                        <TextBlock Text="{Binding Ui.GuideBrowseBody}" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <Border Style="{StaticResource GuideNoteBorder}">
                            <DockPanel>
                                <Viewbox Width="16" Height="16" Margin="0,1,10,0" DockPanel.Dock="Left" VerticalAlignment="Top">
                                    <Canvas Width="16" Height="16">
                                        <Path Fill="{StaticResource AccentAmberHotBrush}" Data="{StaticResource IconNoticeGeometry}" />
                                        <Path Fill="{StaticResource TextOnAccentBrush}" Data="{StaticResource IconNoticeMarkGeometry}" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="{Binding Ui.GuideNoteRisk}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="{Binding Ui.GuideOpenCatalog}" Command="{Binding ShowCatalogPageCommand}" Margin="0,0,8,0" Style="{StaticResource GhostButtonStyle}" />
                            <Button Content="{Binding Ui.GuideOpenLibrary}" Command="{Binding ShowLibraryPageCommand}" Style="{StaticResource GhostButtonStyle}" />
                        </StackPanel>

                        <TextBlock Text="{Binding Ui.GuideApplyTitle}" FontWeight="SemiBold" Margin="0,8,0,4" />
                        <TextBlock Text="{Binding Ui.GuideApplyBody}" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <Border Style="{StaticResource GuideNoteBorder}">
                            <DockPanel>
                                <Viewbox Width="16" Height="16" Margin="0,1,10,0" DockPanel.Dock="Left" VerticalAlignment="Top">
                                    <Canvas Width="16" Height="16">
                                        <Path Fill="{StaticResource AccentAmberHotBrush}" Data="{StaticResource IconNoticeGeometry}" />
                                        <Path Fill="{StaticResource TextOnAccentBrush}" Data="{StaticResource IconNoticeMarkGeometry}" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="{Binding Ui.GuideNoteApply}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>

                        <TextBlock Text="{Binding Ui.GuideLaterTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,8" />

                        <TextBlock Text="{Binding Ui.GuideLaunchTitle}" FontWeight="SemiBold" Margin="0,8,0,4" />
                        <TextBlock Text="{Binding Ui.GuideLaunchBody}" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <Button Content="{Binding Ui.GuideOpenSettings}" Command="{Binding ShowSettingsPageCommand}" HorizontalAlignment="Left" Margin="0,0,0,8" Style="{StaticResource GhostButtonStyle}" />

                        <TextBlock Text="{Binding Ui.GuideProfilesTitle}" FontWeight="SemiBold" Margin="0,8,0,4" />
                        <TextBlock Text="{Binding Ui.GuideProfilesBody}" TextWrapping="Wrap" Margin="0,0,0,8" />

                        <TextBlock Text="{Binding Ui.GuideImportTitle}" FontWeight="SemiBold" Margin="0,8,0,4" />
                        <TextBlock Text="{Binding Ui.GuideImportBody}" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <Button Content="{Binding Ui.GuideOpenLibrary}" Command="{Binding ShowLibraryPageCommand}" HorizontalAlignment="Left" Margin="0,0,0,8" Style="{StaticResource GhostButtonStyle}" />

                        <TextBlock Text="{Binding Ui.GuideUpdatesTitle}" FontWeight="SemiBold" Margin="0,8,0,4" />
                        <TextBlock Text="{Binding Ui.GuideUpdatesBody}" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <Button Content="{Binding Ui.GuideOpenSettings}" Command="{Binding ShowSettingsPageCommand}" HorizontalAlignment="Left" Margin="0,0,0,8" Style="{StaticResource GhostButtonStyle}" />

                        <TextBlock Text="{Binding Ui.GuideBranchTitle}" FontWeight="SemiBold" Margin="0,8,0,4" />
                        <TextBlock Text="{Binding Ui.GuideBranchBody}" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <Border Style="{StaticResource GuideNoteBorder}">
                            <DockPanel>
                                <Viewbox Width="16" Height="16" Margin="0,1,10,0" DockPanel.Dock="Left" VerticalAlignment="Top">
                                    <Canvas Width="16" Height="16">
                                        <Path Fill="{StaticResource AccentAmberHotBrush}" Data="{StaticResource IconNoticeGeometry}" />
                                        <Path Fill="{StaticResource TextOnAccentBrush}" Data="{StaticResource IconNoticeMarkGeometry}" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="{Binding Ui.GuideNoteBranch}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <Button Content="{Binding Ui.GuideOpenBranch}" Command="{Binding ShowBranchPageCommand}" HorizontalAlignment="Left" Margin="0,0,0,8" Style="{StaticResource GhostButtonStyle}" />

                        <TextBlock Text="{Binding Ui.GuideSupportTitle}" FontWeight="SemiBold" Margin="0,8,0,4" />
                        <TextBlock Text="{Binding Ui.GuideSupportBody}" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <Button Content="{Binding Ui.GuideOpenSettings}" Command="{Binding ShowSettingsPageCommand}" HorizontalAlignment="Left" Margin="0,0,0,8" Style="{StaticResource GhostButtonStyle}" />

                        <TextBlock Text="{Binding Ui.GuideCommunityTitle}" FontWeight="SemiBold" Margin="0,8,0,4" />
                        <TextBlock Text="{Binding Ui.GuideCommunityBody}" TextWrapping="Wrap" Margin="0,0,0,4" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Branch page: official / test switch and the controls that belong to it -->
            <Border Style="{StaticResource PanelChromeStyle}"
                    Padding="14,10"
                    Margin="12,8,12,8"
                    Visibility="{Binding IsBranchPage, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="920" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding Ui.BranchSwitchTitle}"
                                   Style="{StaticResource SectionLabelStyle}"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="{Binding Ui.BranchSwitchHint}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,0,0,8" />
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="{Binding Ui.BranchSwitchStatus}"
                                       Width="120"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       DockPanel.Dock="Left"
                                       Margin="0,0,8,0" />
                            <TextBlock Text="{Binding BranchStatusText}"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="{Binding Ui.GamePath}"
                                       Width="120"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       DockPanel.Dock="Left"
                                       Margin="0,0,8,0" />
                            <Button Content="{Binding Ui.BrowseEllipsis}"
                                    Command="{Binding BrowseGamePathCommand}"
                                    DockPanel.Dock="Right"
                                    Margin="8,0,0,0"
                                    MinWidth="72" />
                            <TextBox Text="{Binding GamePath, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="{Binding Ui.BranchSwitchBetaName}"
                                       Width="120"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       DockPanel.Dock="Left"
                                       Margin="0,0,8,0" />
                            <TextBox Text="{Binding BetaBranchName, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalAlignment="Center" />
                        </DockPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <DockPanel>
                                <TextBlock Text="{Binding Ui.BranchSwitchOfficialProfile}"
                                           Width="120"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           DockPanel.Dock="Left"
                                           Margin="0,0,8,0" />
                                <ComboBox ItemsSource="{Binding Profiles}"
                                          SelectedValue="{Binding OfficialProfileId}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="Name"
                                          VerticalAlignment="Center" />
                            </DockPanel>
                            <DockPanel Grid.Column="2">
                                <TextBlock Text="{Binding Ui.BranchSwitchBetaProfile}"
                                           Width="120"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           DockPanel.Dock="Left"
                                           Margin="0,0,8,0" />
                                <ComboBox ItemsSource="{Binding Profiles}"
                                          SelectedValue="{Binding BetaProfileId}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="Name"
                                          VerticalAlignment="Center" />
                            </DockPanel>
                        </Grid>
                        <WrapPanel>
                            <Button Content="{Binding Ui.BranchSwitchToOfficial}"
                                    Command="{Binding SwitchToOfficialCommand}"
                                    IsEnabled="{Binding CanSwitchGameBranch}"
                                    Style="{StaticResource GhostButtonStyle}"
                                    MinWidth="108"
                                    Margin="0,0,8,4"
                                    Padding="12,6" />
                            <Button Content="{Binding Ui.BranchSwitchToBeta}"
                                    Command="{Binding SwitchToBetaCommand}"
                                    IsEnabled="{Binding CanSwitchGameBranch}"
                                    Style="{StaticResource GhostButtonStyle}"
                                    MinWidth="108"
                                    Margin="0,0,8,4"
                                    Padding="12,6" />
                            <Button Content="{Binding Ui.BranchSwitchStartWizard}"
                                    Command="{Binding StartBranchWizardCommand}"
                                    IsEnabled="{Binding CanStartBranchWizard}"
                                    Style="{StaticResource GhostButtonStyle}"
                                    MinWidth="120"
                                    Margin="0,0,8,4"
                                    Padding="12,6" />
                            <Button Content="{Binding Ui.BranchSwitchEmergencyRecover}"
                                    Command="{Binding EmergencyRecoverSingleCommand}"
                                    IsEnabled="{Binding CanEmergencyRecoverSingle}"
                                    Visibility="{Binding ShowEmergencyRecoverSingle, Converter={StaticResource BoolToVis}}"
                                    Style="{StaticResource GhostButtonStyle}"
                                    MinWidth="120"
                                    Margin="0,0,8,4"
                                    Padding="12,6" />
                            <Button Content="{Binding WizardExitSteamConfirmButtonText}"
                                    Command="{Binding ConfirmWizardExitSteamCommand}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Visibility="{Binding ShowConfirmWizardExitSteam, Converter={StaticResource BoolToVis}}"
                                    MinWidth="160"
                                    Margin="0,0,8,4"
                                    Padding="12,6" />
                            <Button Content="{Binding SettleConfirmButtonText}"
                                    Command="{Binding ConfirmManualBetaCommand}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Visibility="{Binding ShowConfirmManualBeta, Converter={StaticResource BoolToVis}}"
                                    MinWidth="120"
                                    Margin="0,0,0,4"
                                    Padding="12,6" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Settings page -->
            <Border Style="{StaticResource PanelChromeStyle}"
                    Padding="14,10"
                    Margin="12,8,12,8"
                    Visibility="{Binding IsSettingsPage, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="1" Margin="0,0,16,0">
                        <TextBlock Text="{Binding Ui.GamePath}"
                                   Width="72"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   DockPanel.Dock="Left" />
                        <Button Content="{Binding Ui.BrowseEllipsis}"
                                Command="{Binding BrowseGamePathCommand}"
                                DockPanel.Dock="Right"
                                Margin="8,0,0,0"
                                MinWidth="72" />
                        <TextBox Text="{Binding GamePath, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center" />
                    </DockPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="{Binding Ui.LaunchMode}"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,0,8,0" />
                        <ComboBox Width="150"
                                  ItemsSource="{Binding LaunchModeOptions}"
                                  SelectedValue="{Binding LaunchMode}"
                                  SelectedValuePath="Mode"
                                  DisplayMemberPath="Label" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="2" VerticalAlignment="Center">
                        <CheckBox Content="{Binding Ui.PortableDataRoot}"
                                  IsChecked="{Binding UsePortableDataRoot}" />
                        <CheckBox Content="{Binding Ui.CheckModUpdatesOnStartup}"
                                  IsChecked="{Binding CheckModUpdatesOnStartup}"
                                  Margin="0,6,0,0" />
                        <CheckBox Content="{Binding Ui.HideMelonConsole}"
                                  IsChecked="{Binding HideMelonConsole}"
                                  ToolTip="{Binding Ui.HideMelonConsoleTip}"
                                  Margin="0,6,0,0" />
                    </StackPanel>

                    <Expander Grid.Row="2" Grid.ColumnSpan="3"
                              Margin="0,12,0,0"
                              IsExpanded="False">
                        <Expander.Header>
                            <StackPanel>
                                <TextBlock Text="{Binding Ui.SettingsAdvanced}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding MirrorSummaryText}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Margin="0,8,0,0">
                            <DockPanel>
                                <TextBlock Text="{Binding Ui.MirrorBaseUrl}"
                                           Width="120"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           DockPanel.Dock="Left"
                                           Margin="0,0,8,0" />
                                <TextBox Text="{Binding MirrorBaseUrl, UpdateSourceTrigger=LostFocus}"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="{Binding Ui.MirrorBaseUrlHint}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </Expander>

                    <DockPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="0,10,0,0">
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   DockPanel.Dock="Left"
                                   Margin="0,0,12,0">
                            <Run Text="{Binding Ui.LabelVersion, Mode=OneWay}" />
                            <Run Text=" " />
                            <Run Text="{Binding AppVersion, Mode=OneWay}" />
                        </TextBlock>
                        <Button Content="{Binding Ui.CheckUpdates}"
                                Command="{Binding CheckForUpdatesCommand}"
                                DockPanel.Dock="Left"
                                MinWidth="108"
                                Margin="0,0,12,0" />
                        <Button Content="{Binding Ui.ImportFromGame}"
                                Command="{Binding ImportFromGameCommand}"
                                DockPanel.Dock="Left"
                                MinWidth="96"
                                Margin="0,0,12,0"
                                Style="{StaticResource GhostButtonStyle}" />
                        <Button Content="{Binding Ui.ExportDiagnosticsButton}"
                                Command="{Binding ExportDiagnosticsCommand}"
                                DockPanel.Dock="Left"
                                MinWidth="96"
                                Margin="0,0,12,0"
                                Style="{StaticResource GhostButtonStyle}" />
                        <Button Content="{Binding Ui.PureGameCleanupButton}"
                                Command="{Binding PureGameCleanupCommand}"
                                DockPanel.Dock="Left"
                                MinWidth="140"
                                Margin="0,0,12,0"
                                Style="{StaticResource GhostButtonStyle}" />
                        <TextBlock Text="{Binding Ui.Language}"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   DockPanel.Dock="Left"
                                   Margin="0,0,8,0" />
                        <ComboBox Width="140"
                                  ItemsSource="{Binding LanguageOptions}"
                                  SelectedValue="{Binding SelectedUiLanguageCode}"
                                  SelectedValuePath="Code"
                                  DisplayMemberPath="Label"
                                  DockPanel.Dock="Left"
                                  Margin="0,0,12,0"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Ui.UiScale}"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   DockPanel.Dock="Left"
                                   Margin="0,0,8,0" />
                        <ComboBox Width="188"
                                  ItemsSource="{Binding UiScaleOptions}"
                                  SelectedValue="{Binding SelectedUiScaleCode}"
                                  SelectedValuePath="Code"
                                  DisplayMemberPath="Label"
                                  DockPanel.Dock="Left"
                                  Margin="0,0,12,0"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="{Binding UpdateStatus}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </DockPanel>

                    <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Margin="0,14,0,0">
                        <DockPanel Margin="0,0,0,6">
                            <Button Content="{Binding Ui.FeedbackButton}"
                                    Command="{Binding SendFeedbackCommand}"
                                    DockPanel.Dock="Right"
                                    MinWidth="88"
                                    Style="{StaticResource GhostButtonStyle}" />
                            <TextBlock Text="{Binding Ui.CreditsTitle}"
                                       Style="{StaticResource SectionLabelStyle}"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBox Text="{Binding Ui.CreditsBody, Mode=OneWay}"
                                 Style="{StaticResource SelectableReadOnlyTextStyle}"
                                 FontSize="13"
                                 Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </Grid>
                            </ScrollViewer>
            </Border>

            <!-- Catalog page: toolbar + filters / list(*) / detail / status -->
            <Border Margin="12,8,12,8"
                    Style="{StaticResource ContentCardStyle}"
                    Visibility="{Binding IsCatalogPage, Converter={StaticResource BoolToVis}}">
                <Grid x:Name="CatalogPageRoot">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="200" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Toolbar + filters -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    DockPanel.Dock="Right">
                            <Button Command="{Binding RefreshCatalogCommand}"
                                    Margin="0,0,8,0"
                                    MinWidth="88"
                                    Style="{StaticResource GhostButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="14" Height="14" Margin="0,0,6,0"
                                          Stretch="Uniform"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="{StaticResource IconRefreshGeometry}" />
                                    <TextBlock Text="{Binding Ui.RefreshCatalog}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding AddCatalogModToLibraryCommand}"
                                    MinWidth="96"
                                    Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="14" Height="14" Margin="0,0,6,0"
                                          Stretch="Uniform"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="{StaticResource IconPlusGeometry}" />
                                    <TextBlock Text="{Binding Ui.AddToLibrary}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <DockPanel Width="180" MinHeight="36" Margin="0,0,8,0" LastChildFill="True">
                            <Path Width="14" Height="14" Margin="0,0,6,0"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Fill="{StaticResource TextMutedBrush}"
                                  DockPanel.Dock="Left"
                                  Data="{StaticResource IconSearchGeometry}" />
                            <TextBox VerticalContentAlignment="Center"
                                     ToolTip="{Binding Ui.FilterSearch}"
                                     Text="{Binding CatalogSearchText, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Ui.FilterCategory}"
                                       Style="{StaticResource FilterFieldLabelStyle}" />
                            <ComboBox Width="140" MinHeight="36"
                                      ToolTip="{Binding Ui.FilterCategory}"
                                      ItemsSource="{Binding CatalogCategoryFilterOptions}"
                                      SelectedItem="{Binding SelectedCatalogCategoryFilter}"
                                      ItemTemplate="{StaticResource FilterOptionLabelTemplate}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Ui.FilterTag}"
                                       Style="{StaticResource FilterFieldLabelStyle}" />
                            <ComboBox Width="120" MinHeight="36"
                                      ToolTip="{Binding Ui.FilterTag}"
                                      ItemsSource="{Binding CatalogAvailableTagOptions}"
                                      SelectedItem="{Binding SelectedCatalogTagFilter}"
                                      ItemTemplate="{StaticResource FilterOptionLabelTemplate}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Ui.FilterSort}"
                                       Style="{StaticResource FilterFieldLabelStyle}" />
                            <ComboBox Width="140" MinHeight="36"
                                      ToolTip="{Binding Ui.FilterSort}"
                                      ItemsSource="{Binding SortModeOptions}"
                                      SelectedItem="{Binding SelectedCatalogSortMode}"
                                      ItemTemplate="{StaticResource FilterOptionLabelTemplate}" />
                        </StackPanel>
                    </DockPanel>

                    <StackPanel Grid.Row="1"
                                Margin="0,0,0,10"
                                Visibility="{Binding HasFeaturedCatalogMods, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Style="{StaticResource AccentBarStyle}"
                                    Height="14"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Ui.FeaturedModsTitle}"
                                       Style="{StaticResource SectionLabelStyle}"
                                       Margin="0"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Ui.FeaturedModsHint}"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding FeaturedCatalogMods}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,0,8,8"
                                            Padding="8,6"
                                            MinWidth="220"
                                            MaxWidth="280"
                                            MinHeight="72"
                                            HorizontalContentAlignment="Left"
                                            Command="{Binding DataContext.SelectFeaturedCatalogModCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFeaturedLead}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentAmberBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <DockPanel>
                                            <Border Width="72"
                                                    Height="48"
                                                    Margin="0,0,10,0"
                                                    DockPanel.Dock="Left"
                                                    Background="{StaticResource BgDeepBrush}"
                                                    ClipToBounds="True">
                                                <Image Source="{Binding PreviewImage}" Stretch="UniformToFill" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Author}"
                                                           Margin="0,2,0,0"
                                                           FontSize="13"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding StatusText}"
                                                           Margin="0,2,0,0"
                                                           FontSize="13"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Mod list fills remaining height -->
                    <Grid Grid.Row="2" MinHeight="160">
                        <!-- Row virtualization is on by default and measured to hold here (13 of
                             5000 rows realised); Recycling is not the default, and reuses row
                             containers instead of rebuilding one per scrolled row. -->
                        <DataGrid x:Name="CatalogModsGrid"
                                  ItemsSource="{Binding CatalogModsView}"
                                  SelectedItem="{Binding SelectedCatalogMod}"
                                  SelectionMode="Extended"
                                  SelectionChanged="CatalogModsGrid_SelectionChanged"
                                  SizeChanged="ModsGrid_SizeChanged"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  EnableRowVirtualization="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.IsDeferredScrollingEnabled="False"
                                  VerticalAlignment="Stretch">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="48" MinWidth="48">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}, Mode=TwoWay}"
                                                      PreviewMouseLeftButtonDown="CatalogModCheckBox_PreviewMouseLeftButtonDown" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{Binding Data.Ui.ColumnName, Source={StaticResource Proxy}}"
                                                    Binding="{Binding Name}"
                                                    ElementStyle="{StaticResource GridNameTextStyle}"
                                                    Width="2.6*"
                                                    MinWidth="220"
                                                    MaxWidth="420" />
                                <DataGridTextColumn Header="{Binding Data.Ui.ColumnCategory, Source={StaticResource Proxy}}"
                                                    Binding="{Binding EffectiveCategoryDisplay}"
                                                    ElementStyle="{StaticResource GridCellTextStyle}"
                                                    Width="1.6*"
                                                    MinWidth="120" />
                                <DataGridTextColumn Header="{Binding Data.Ui.ColumnTag, Source={StaticResource Proxy}}"
                                                    Binding="{Binding EffectiveTagsText}"
                                                    ElementStyle="{StaticResource GridCellTextStyle}"
                                                    Width="1.8*"
                                                    MinWidth="130" />
                                <DataGridTextColumn Header="{Binding Data.Ui.ColumnAuthor, Source={StaticResource Proxy}}"
                                                    Binding="{Binding Author}"
                                                    ElementStyle="{StaticResource GridCellTextStyle}"
                                                    Width="1.2*"
                                                    MinWidth="90" />
                                <DataGridTextColumn Header="{Binding Data.Ui.ColumnVersion, Source={StaticResource Proxy}}"
                                                    Binding="{Binding Version}"
                                                    ElementStyle="{StaticResource GridCellTextStyle}"
                                                    Width="80"
                                                    MinWidth="72" />
                                <DataGridTextColumn Header="{Binding Data.Ui.ColumnUpdated, Source={StaticResource Proxy}}"
                                                    Binding="{Binding UpdatedAt}"
                                                    ElementStyle="{StaticResource GridCellTextStyle}"
                                                    Width="110"
                                                    MinWidth="96" />
                                <DataGridTextColumn Header="{Binding Data.Ui.ColumnStatus, Source={StaticResource Proxy}}"
                                                    Binding="{Binding StatusText}"
                                                    ElementStyle="{StaticResource GridCellTextStyle}"
                                                    Width="120"
                                                    MinWidth="100" />
