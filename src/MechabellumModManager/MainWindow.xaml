                    </DockPanel>
                </Border>

                <GridSplitter Grid.Column="1"
                              Width="10"
                              HorizontalAlignment="Stretch"
                              Background="Transparent"
                              ResizeBehavior="PreviousAndNext" />

                <Border Grid.Column="2" Style="{StaticResource PanelChromeStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="180" />
                            <RowDefinition Height="Auto" MaxHeight="160" />
                        </Grid.RowDefinitions>

                        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Grid Width="220" MinHeight="36" Margin="0,0,8,0">
                                    <TextBox VerticalContentAlignment="Center"
                                             Padding="28,6,8,6"
                                             ToolTip="{Binding Ui.FilterSearch}"
                                             Text="{Binding LibrarySearchText, UpdateSourceTrigger=PropertyChanged}" />
                                    <Path Width="14" Height="14" Margin="8,0,0,0"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          IsHitTestVisible="False"
                                          Fill="{StaticResource TextMutedBrush}"
                                          Data="{StaticResource IconSearchGeometry}" />
                                    <TextBlock Margin="28,0,8,0"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="14"
                                               Text="{Binding Ui.SearchModName}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LibrarySearchText}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding LibrarySearchText}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <Button Content="{Binding Ui.EditModTaxonomy}"
                                        Command="{Binding EditLibraryModTaxonomyCommand}"
                                        MinHeight="36"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource GhostButtonStyle}" />
                                <Button Command="{Binding ApplyProfileCommand}"
                                        MinHeight="36"
                                        MinWidth="96"
                                        Margin="0,0,8,0"
                                        ToolTip="{Binding DeployBlockedReason}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UseApplyAccent}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource AccentAmberBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentPressedBrush}" />
                                                <Setter Property="Foreground" Value="{StaticResource TextOnAccentBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="14" Height="14" Margin="0,0,6,0"
                                          Stretch="Uniform"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="{StaticResource IconCheckGeometry}" />
                                    <TextBlock Text="{Binding Ui.ApplyProfile}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                                <Button Command="{Binding ImportDllCommand}"
                                        Margin="0,0,8,0"
                                        MinWidth="96">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="14" Height="14" Margin="0,0,6,0"
                                              Stretch="Uniform"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="{StaticResource IconImportGeometry}" />
                                        <TextBlock Text="{Binding Ui.ImportDll}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ImportZipCommand}"
                                        Margin="0,0,8,0"
                                        MinWidth="96">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="14" Height="14" Margin="0,0,6,0"
                                              Stretch="Uniform"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="{StaticResource IconImportGeometry}" />
                                        <TextBlock Text="{Binding Ui.ImportZip}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ImportFolderCommand}"
                                        Margin="0,0,8,0"
                                        MinWidth="108">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="14" Height="14" Margin="0,0,6,0"
                                              Stretch="Uniform"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="{StaticResource IconImportGeometry}" />
                                        <TextBlock Text="{Binding Ui.ImportFolder}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ReloadLibraryCommand}"
