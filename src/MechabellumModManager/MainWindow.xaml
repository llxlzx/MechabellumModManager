                                                   FontSize="14"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="13"
                                                   TextWrapping="Wrap">
                                            <Run Text="{Binding Ui.LabelAuthor, Mode=OneWay}" />
                                            <Run Text="：" />
                                            <Run Text="{Binding SelectedCatalogMod.Author, Mode=OneWay}" />
                                            <Run Text="  ·  " />
                                            <Run Text="{Binding Ui.LabelVersion, Mode=OneWay}" />
                                            <Run Text="：" />
                                            <Run Text="{Binding SelectedCatalogMod.Version, Mode=OneWay}" />
                                            <Run Text="  ·  " />
                                            <Run Text="{Binding Ui.LabelUpdated, Mode=OneWay}" />
                                            <Run Text="：" />
                                            <Run Text="{Binding SelectedCatalogMod.UpdatedAt, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Margin="0,8,0,0"
                                                   Text="{Binding SelectedCatalogMod.Summary}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextWrapping="Wrap"
                                                   FontSize="13" />
                                        <TextBlock Margin="0,6,0,0"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding SelectedCatalogMod.EffectiveTagsText, Converter={StaticResource NonEmptyVis}}">
                                            <Run Text="{Binding Ui.TagsLabel, Mode=OneWay}" />
                                            <Run Text="：" />
                                            <Run Text="{Binding SelectedCatalogMod.EffectiveTagsText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </DockPanel>
                    </Border>

                    <StackPanel Grid.Row="4" Margin="0,8,0,0">
                        <ProgressBar Height="6"
                                     Margin="0,0,0,6"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding CatalogDownloadPercent, Mode=OneWay}"
                                     IsIndeterminate="{Binding IsCatalogDownloadIndeterminate, Mode=OneWay}"
                                     Background="{StaticResource BgElevatedBrush}"
                                     Foreground="{StaticResource AccentAmberBrush}"
                                     BorderThickness="0"
                                     Visibility="{Binding IsCatalogDownloading, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding CatalogStatus}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="13" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Library page -->
            <Grid Margin="12,8,12,8"
                  Visibility="{Binding IsLibraryPage, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" MinWidth="180" MaxWidth="210" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" MinWidth="400" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource PanelChromeStyle}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Style="{StaticResource AccentBarStyle}"
                                    Height="14"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Ui.Profiles}"
                                       Style="{StaticResource SectionLabelStyle}"
                                       Margin="0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <UniformGrid Rows="2" Columns="2"
                                     DockPanel.Dock="Bottom"
                                     Margin="0,12,0,0">
                            <Button Content="{Binding Ui.ProfileNew}"
                                    Command="{Binding CreateProfileCommand}"
                                    Margin="0,0,4,4" />
                            <Button Content="{Binding Ui.ProfileRename}"
                                    Command="{Binding RenameProfileCommand}"
                                    Margin="4,0,0,4" />
                            <Button Content="{Binding Ui.ProfileDuplicate}"
                                    Command="{Binding DuplicateProfileCommand}"
                                    Margin="0,4,4,0" />
                            <Button Content="{Binding Ui.ProfileDelete}"
                                    Command="{Binding DeleteProfileCommand}"
                                    Margin="4,4,0,0" />
                        </UniformGrid>
                        <ListBox ItemsSource="{Binding Profiles}"
                                 SelectedItem="{Binding SelectedProfile}"
                                 DisplayMemberPath="Name"
                                 ItemContainerStyle="{StaticResource ProfileListItemStyle}"
