<Window x:Class="MechabellumModManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:MechabellumModManager.Converters"
        mc:Ignorable="d"
        Title="钢铁指挥官 Mod 管理器"
        Height="740"
        Width="1200"
        MinHeight="600"
        MinWidth="780"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}">
    <Window.Resources>
        <conv:NonEmptyStringToVisibilityConverter x:Key="NonEmptyVis" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
    </Window.Resources>

    <Grid>
        <!-- Atmosphere (non-interactive) -->
        <Grid IsHitTestVisible="False">
            <Rectangle Fill="{StaticResource WindowBackgroundBrush}" />
            <Rectangle Fill="{StaticResource AtmosphereGlowBrush}" />
            <Rectangle Fill="{StaticResource GridOverlayBrush}" Opacity="0.35" />
            <Rectangle Fill="{StaticResource VignetteBrush}" />
        </Grid>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top: always two rows — brand/status, then profile/actions -->
            <Border Grid.Row="0"
                    Background="{StaticResource HeaderBarBrush}"
                    BorderBrush="{StaticResource SteelEdgeBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Row 1: brand + status -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="120" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="40"
                                    Height="40"
                                    CornerRadius="4"
                                    BorderBrush="{StaticResource SteelEdgeBrush}"
                                    BorderThickness="1"
                                    Background="#FF0C1014"
                                    Margin="0,0,12,0"
                                    SnapsToDevicePixels="True">
                                <Image x:Name="BrandImage"
                                       Stretch="Uniform"
                                       Margin="3"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <Border Style="{StaticResource AccentBarStyle}"
                                    Height="34"
                                    Margin="0,0,12,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="钢铁指挥官"
                                           Style="{StaticResource ShellTitleStyle}" />
                                <TextBlock Text="Mod 管理器 · Mechabellum"
                                           Style="{StaticResource ShellSubtitleStyle}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Background="#CC1E262E"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="12,7"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Stretch">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{StaticResource SteelEdgeBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsReady}" Value="False">
                                            <Setter Property="BorderBrush" Value="{StaticResource WarnBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsReady}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentTealBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding StatusKindLabel}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsReady}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentAmberHotBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding GameStatus.Message}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"
                                           ToolTip="{Binding GameStatus.Message}" />
                                <Button Grid.Column="2"
                                        MinWidth="108"
                                        Padding="10,4"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Command="{Binding InstallMelonLoaderCommand}"
                                        Content="{Binding Ui.InstallMelonLoader}"
                                        Visibility="{Binding NeedsMelonLoaderInstall, Converter={StaticResource BoolToVis}}"
                                        ToolTip="{Binding Ui.InstallMelonLoaderTip}" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Row 2: profile left, actions wrap right -->
                    <Border Grid.Row="1"
                            Margin="0,10,0,0"
                            Padding="0,10,0,0"
                            BorderBrush="{StaticResource SteelEdgeBrush}"
                            BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="0,0,12,0">
                                <TextBlock Text="{Binding Ui.CurrentProfile}"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Margin="0,0,8,0" />
                                <ComboBox MinWidth="120"
                                          Width="160"
                                          ItemsSource="{Binding Profiles}"
                                          SelectedItem="{Binding SelectedProfile}"
                                          DisplayMemberPath="Name"
                                          VerticalAlignment="Center" />
                            </StackPanel>

                            <WrapPanel Grid.Column="1"
                                       Orientation="Horizontal"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center">
                                <Button Command="{Binding ApplyAndLaunchCommand}"
                                        IsEnabled="{Binding CanDeployOrLaunch}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Margin="0,0,8,4"
                                        MinWidth="108"
                                        Padding="12,6">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="14" Height="14" Margin="0,0,6,0"
                                              Stretch="Uniform"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="{StaticResource IconPlayGeometry}" />
                                        <TextBlock Text="{Binding Ui.ApplyAndLaunch}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ShowLibraryPageCommand}"
                                        Margin="0,0,8,4"
                                        MinWidth="88"
                                        Padding="12,6"
                                        ToolTip="{Binding Ui.NavLibraryTip}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLibraryPage}" Value="True">
                                                    <Setter Property="Background" Value="#FF2A2418" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentAmberBrush}" />
                                                    <Setter Property="Foreground" Value="{StaticResource AccentAmberHotBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="{Binding Ui.ModLibrary}" VerticalAlignment="Center" />
                                </Button>
                                <Button Command="{Binding ShowCatalogPageCommand}"
                                        Margin="0,0,8,4"
                                        MinWidth="88"
                                        Padding="12,6"
                                        ToolTip="{Binding Ui.NavWorkshopTip}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCatalogPage}" Value="True">
                                                    <Setter Property="Background" Value="#FF2A2418" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentAmberBrush}" />
                                                    <Setter Property="Foreground" Value="{StaticResource AccentAmberHotBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="{Binding Ui.BrowseMods}" VerticalAlignment="Center" />
                                </Button>
                                <Button Command="{Binding SubmitModCommand}"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Margin="0,0,8,4"
                                        MinWidth="88"
                                        Padding="12,6">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="14" Height="14" Margin="0,0,6,0"
                                              Stretch="Uniform"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="{StaticResource IconUploadGeometry}" />
                                        <TextBlock Text="{Binding Ui.SubmitMod}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ShowSettingsPageCommand}"
                                        Margin="0,0,0,4"
                                        MinWidth="72"
                                        Padding="12,6">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSettingsPage}" Value="True">
                                                    <Setter Property="Background" Value="#FF2A2418" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentAmberBrush}" />
                                                    <Setter Property="Foreground" Value="{StaticResource AccentAmberHotBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="14" Height="14" Margin="0,0,6,0"
                                              Stretch="Uniform"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="{StaticResource IconGearGeometry}" />
                                        <TextBlock Text="{Binding Ui.Settings}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Content pages host (exclusive: settings / catalog / library) -->
            <Grid Grid.Row="1" x:Name="ContentPagesHost">

            <!-- Settings page -->
            <Border Style="{StaticResource PanelChromeStyle}"
                    Padding="14,10"
                    Margin="12,8,12,8"
                    Visibility="{Binding IsSettingsPage, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.ColumnSpan="3"
                               Text="{Binding Ui.Settings}"
                               Style="{StaticResource SectionLabelStyle}" />

                    <DockPanel Grid.Row="1" Margin="0,0,16,0">
                        <TextBlock Text="{Binding Ui.GamePath}"
                                   Width="72"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   DockPanel.Dock="Left" />
                        <Button Content="浏览…"
                                Command="{Binding BrowseGamePathCommand}"
                                DockPanel.Dock="Right"
                                Margin="8,0,0,0"
                                MinWidth="72" />
                        <TextBox Text="{Binding GamePath, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center" />
                    </DockPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="{Binding Ui.LaunchMode}"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,0,8,0" />
                        <ComboBox Width="150"
                                  ItemsSource="{Binding LaunchModeOptions}"
                                  SelectedValue="{Binding LaunchMode}"
                                  SelectedValuePath="Mode"
                                  DisplayMemberPath="Label" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="2" VerticalAlignment="Center">
                        <CheckBox Content="{Binding Ui.PortableDataRoot}"
                                  IsChecked="{Binding UsePortableDataRoot}" />
                    </StackPanel>

                    
                    <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,14,0,0">
                        <TextBlock Text="{Binding Ui.BranchSwitchTitle}"
                                   Style="{StaticResource SectionLabelStyle}"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="{Binding Ui.BranchSwitchHint}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,0,0,8" />
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="{Binding Ui.BranchSwitchStatus}"
                                       Width="120"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       DockPanel.Dock="Left"
                                       Margin="0,0,8,0" />
                            <TextBlock Text="{Binding BranchStatusText}"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="{Binding Ui.BranchSwitchBetaName}"
                                       Width="120"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       DockPanel.Dock="Left"
                                       Margin="0,0,8,0" />
                            <TextBox Text="{Binding BetaBranchName, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalAlignment="Center" />
                        </DockPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <DockPanel>
                                <TextBlock Text="{Binding Ui.BranchSwitchOfficialProfile}"
                                           Width="120"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           DockPanel.Dock="Left"
                                           Margin="0,0,8,0" />
                                <ComboBox ItemsSource="{Binding Profiles}"
                                          SelectedValue="{Binding OfficialProfileId}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="Name"
                                          VerticalAlignment="Center" />
                            </DockPanel>
                            <DockPanel Grid.Column="2">
                                <TextBlock Text="{Binding Ui.BranchSwitchBetaProfile}"
                                           Width="120"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           DockPanel.Dock="Left"
                                           Margin="0,0,8,0" />
                                <ComboBox ItemsSource="{Binding Profiles}"
                                          SelectedValue="{Binding BetaProfileId}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="Name"
                                          VerticalAlignment="Center" />
                            </DockPanel>
                        </Grid>
                        <WrapPanel>
                            <Button Content="{Binding Ui.BranchSwitchToOfficial}"
                                    Command="{Binding SwitchToOfficialCommand}"
                                    IsEnabled="{Binding CanSwitchGameBranch}"
                                    Style="{StaticResource GhostButtonStyle}"
                                    MinWidth="108"
                                    Margin="0,0,8,4"
                                    Padding="12,6" />
                            <Button Content="{Binding Ui.BranchSwitchToBeta}"
                                    Command="{Binding SwitchToBetaCommand}"
                                    IsEnabled="{Binding CanSwitchGameBranch}"
                                    Style="{StaticResource GhostButtonStyle}"
                                    MinWidth="108"
                                    Margin="0,0,8,4"
                                    Padding="12,6" />
                            <Button Content="{Binding Ui.BranchSwitchStartWizard}"
                                    Command="{Binding StartBranchWizardCommand}"
                                    IsEnabled="{Binding CanStartBranchWizard}"
                                    Style="{StaticResource GhostButtonStyle}"
                                    MinWidth="120"
                                    Margin="0,0,8,4"
                                    Padding="12,6" />
                            <Button Content="{Binding Ui.BranchSwitchTeardown}"
                                    Command="{Binding TeardownBranchSwitchCommand}"
                                    IsEnabled="{Binding CanTeardownBranchSwitch}"
                                    Style="{StaticResource GhostButtonStyle}"
                                    MinWidth="120"
                                    Margin="0,0,8,4"
                                    Padding="12,6" />
                            <Button Content="{Binding SettleConfirmButtonText}"
                                    Command="{Binding ConfirmManualBetaCommand}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Visibility="{Binding ShowConfirmManualBeta, Converter={StaticResource BoolToVis}}"
                                    MinWidth="120"
                                    Margin="0,0,0,4"
                                    Padding="12,6" />
                        </WrapPanel>
                    </StackPanel>

                    <DockPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="0,10,0,0">
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   DockPanel.Dock="Left"
                                   Margin="0,0,12,0">
                            <Run Text="{Binding Ui.LabelVersion, Mode=OneWay}" />
                            <Run Text=" " />
                            <Run Text="{Binding AppVersion, Mode=OneWay}" />
                        </TextBlock>
                        <Button Content="{Binding Ui.CheckUpdates}"
                                Command="{Binding CheckForUpdatesCommand}"
                                DockPanel.Dock="Left"
                                MinWidth="88"
                                Margin="0,0,12,0"
                                Style="{StaticResource GhostButtonStyle}" />
                        <Button Content="{Binding Ui.ImportFromGame}"
                                Command="{Binding ImportFromGameCommand}"
                                DockPanel.Dock="Left"
                                MinWidth="96"
                                Margin="0,0,12,0"
                                Style="{StaticResource GhostButtonStyle}" />
                        <TextBlock Text="{Binding Ui.Language}"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   DockPanel.Dock="Left"
                                   Margin="0,0,8,0" />
                        <ComboBox Width="140"
                                  ItemsSource="{Binding LanguageOptions}"
                                  SelectedValue="{Binding SelectedUiLanguageCode}"
                                  SelectedValuePath="Code"
                                  DisplayMemberPath="Label"
                                  DockPanel.Dock="Left"
                                  Margin="0,0,12,0"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="{Binding UpdateStatus}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </DockPanel>

                    <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Margin="0,14,0,0">
                        <TextBlock Text="{Binding Ui.CreditsTitle}"
                                   Style="{StaticResource SectionLabelStyle}"
                                   Margin="0,0,0,6" />
                        <TextBox Text="{Binding Ui.CreditsBody, Mode=OneWay}"
                                 Style="{StaticResource SelectableReadOnlyTextStyle}"
                                 FontSize="12"
                                 Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </Grid>
                            </ScrollViewer>
            </Border>

            <!-- Catalog page: toolbar + filters / list(*) / detail / status -->
            <Border Margin="12,8,12,8"
                    Style="{StaticResource ContentCardStyle}"
                    Visibility="{Binding IsCatalogPage, Converter={StaticResource BoolToVis}}">
                <Grid x:Name="CatalogPageRoot">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="200" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Toolbar + filters -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    DockPanel.Dock="Right">
                            <Button Command="{Binding RefreshCatalogCommand}"
                                    Margin="0,0,8,0"
                                    MinWidth="88"
                                    Style="{StaticResource GhostButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="14" Height="14" Margin="0,0,6,0"
                                          Stretch="Uniform"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="{StaticResource IconRefreshGeometry}" />
                                    <TextBlock Text="{Binding Ui.RefreshCatalog}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding AddCatalogModToLibraryCommand}"
                                    MinWidth="96"
                                    Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="14" Height="14" Margin="0,0,6,0"
                                          Stretch="Uniform"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="{StaticResource IconPlusGeometry}" />
                                    <TextBlock Text="{Binding Ui.AddToLibrary}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <DockPanel Width="180" MinHeight="32" Margin="0,0,8,0" LastChildFill="True">
                            <Path Width="14" Height="14" Margin="0,0,6,0"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Fill="{StaticResource TextMutedBrush}"
                                  DockPanel.Dock="Left"
                                  Data="{StaticResource IconSearchGeometry}" />
                            <TextBox VerticalContentAlignment="Center"
                                     ToolTip="{Binding Ui.FilterSearch}"
                                     Text="{Binding CatalogSearchText, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <ComboBox Width="140" MinHeight="32" Margin="0,0,8,0"
                                  ToolTip="{Binding Ui.FilterCategory}"
                                  ItemsSource="{Binding CatalogCategoryFilterOptions}"
                                  SelectedItem="{Binding SelectedCatalogCategoryFilter}"
                                  DisplayMemberPath="Label" />
                        <ComboBox Width="120" MinHeight="32" Margin="0,0,8,0"
                                  ToolTip="{Binding Ui.FilterTag}"
                                  ItemsSource="{Binding CatalogAvailableTagOptions}"
                                  SelectedItem="{Binding SelectedCatalogTagFilter}"
                                  DisplayMemberPath="Label" />
                        <ComboBox Width="140" MinHeight="32"
                                  ToolTip="{Binding Ui.FilterSort}"
                                  ItemsSource="{Binding SortModeOptions}"
                                  SelectedItem="{Binding SelectedCatalogSortMode}"
                                  DisplayMemberPath="Label" />
                    </DockPanel>

                    <!-- Mod list fills remaining height -->
                    <Grid Grid.Row="1" MinHeight="160">
                        <DataGrid x:Name="CatalogModsGrid"
                                  ItemsSource="{Binding CatalogModsView}"
                                  SelectedItem="{Binding SelectedCatalogMod}"
                                  SelectionMode="Extended"
                                  SelectionChanged="CatalogModsGrid_SelectionChanged"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  VerticalAlignment="Stretch">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="36">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}, Mode=TwoWay}"
                                                      PreviewMouseLeftButtonDown="CatalogModCheckBox_PreviewMouseLeftButtonDown" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{Binding DataContext.Ui.ColumnName, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Binding="{Binding Name}"
                                                    Width="*"
                                                    MinWidth="120" />
                                <DataGridTextColumn Header="{Binding DataContext.Ui.ColumnCategory, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Binding="{Binding EffectiveCategoryDisplay}"
                                                    Width="100" />
                                <DataGridTextColumn Header="{Binding DataContext.Ui.ColumnAuthor, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Binding="{Binding Author}"
                                                    Width="90" />
                                <DataGridTextColumn Header="{Binding DataContext.Ui.ColumnVersion, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Binding="{Binding Version}"
                                                    Width="70" />
                                <DataGridTextColumn Header="{Binding DataContext.Ui.ColumnUpdated, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Binding="{Binding UpdatedAt}"
                                                    Width="100" />
                                <DataGridTextColumn Header="{Binding DataContext.Ui.ColumnStatus, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Binding="{Binding StatusText}"
                                                    Width="72" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="{Binding Ui.CatalogEmptyHint}"
                                   Style="{StaticResource EmptyStateStyle}"
                                   Visibility="{Binding IsCatalogEmpty, Converter={StaticResource BoolToVis}}" />
                    </Grid>

                    <!-- Detail under list -->
                    <Border Grid.Row="2"
                            Margin="0,10,0,0"
                            Padding="0,10,0,0"
                            BorderBrush="{StaticResource SteelEdgeBrush}"
                            BorderThickness="0,1,0,0"
                            MaxHeight="200"
                            Visibility="{Binding SelectedCatalogMod, Converter={StaticResource NullToVis}}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right"
                                        VerticalAlignment="Top"
                                        Margin="8,0,0,0">
                                <Button Command="{Binding ReportCatalogModCommand}"
                                        MinWidth="72"
                                        Padding="10,6"
                                        MinHeight="30"
                                        FontSize="12"
                                        Margin="0,0,0,6"
                                        Style="{StaticResource GhostButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="14" Height="14" Margin="0,0,6,0"
                                              Stretch="Uniform"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="{StaticResource IconFlagGeometry}" />
                                        <TextBlock Text="{Binding Ui.Report}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Content="{Binding Ui.ActionCollapseDetail}"
                                        Command="{Binding ClearCatalogModSelectionCommand}"
                                        MinWidth="72"
                                        Padding="10,6"
                                        MinHeight="30"
                                        FontSize="12"
                                        Style="{StaticResource GhostButtonStyle}" />
                            </StackPanel>
                            <DockPanel>
                                <Image DockPanel.Dock="Left"
                                       Source="{Binding SelectedCatalogMod.PreviewImage}"
                                       MaxHeight="140"
                                       MaxWidth="220"
                                       Stretch="Uniform"
                                       Margin="0,0,14,0"
                                       Cursor="Hand"
                                       ToolTip="{Binding Ui.PreviewImageHint}"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       MouseLeftButtonUp="ModPreviewImage_Click" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="160">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedCatalogMod.Name}"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap">
                                            <Run Text="{Binding Ui.LabelAuthor, Mode=OneWay}" />
                                            <Run Text="：" />
                                            <Run Text="{Binding SelectedCatalogMod.Author, Mode=OneWay}" />
                                            <Run Text="  ·  " />
                                            <Run Text="{Binding Ui.LabelVersion, Mode=OneWay}" />
                                            <Run Text="：" />
                                            <Run Text="{Binding SelectedCatalogMod.Version, Mode=OneWay}" />
                                            <Run Text="  ·  " />
                                            <Run Text="{Binding Ui.LabelUpdated, Mode=OneWay}" />
                                            <Run Text="：" />
                                            <Run Text="{Binding SelectedCatalogMod.UpdatedAt, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Margin="0,8,0,0"
                                                   Text="{Binding SelectedCatalogMod.Summary}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextWrapping="Wrap"
                                                   FontSize="12" />
                                        <TextBlock Margin="0,6,0,0"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding SelectedCatalogMod.EffectiveTagsText, Converter={StaticResource NonEmptyVis}}">
                                            <Run Text="{Binding Ui.TagsLabel, Mode=OneWay}" />
                                            <Run Text="：" />
                                            <Run Text="{Binding SelectedCatalogMod.EffectiveTagsText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </DockPanel>
                    </Border>

                    <TextBlock Grid.Row="3"
                               Margin="0,8,0,0"
                               Text="{Binding CatalogStatus}"
                               Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               FontSize="12" />
                </Grid>
            </Border>

            <!-- Library page -->
            <Grid Margin="12,8,12,8"
                  Visibility="{Binding IsLibraryPage, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" MinWidth="180" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" MinWidth="400" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource PanelChromeStyle}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Style="{StaticResource AccentBarStyle}"
                                    Height="14"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Ui.Profiles}"
                                       Style="{StaticResource SectionLabelStyle}"
                                       Margin="0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <UniformGrid Rows="2" Columns="2"
                                     DockPanel.Dock="Bottom"
                                     Margin="0,12,0,0">
                            <Button Content="新建"
                                    Command="{Binding CreateProfileCommand}"
                                    Margin="0,0,4,4" />
                            <Button Content="重命名"
                                    Command="{Binding RenameProfileCommand}"
                                    Margin="4,0,0,4" />
                            <Button Content="复制"
                                    Command="{Binding DuplicateProfileCommand}"
                                    Margin="0,4,4,0" />
                            <Button Content="删除"
                                    Command="{Binding DeleteProfileCommand}"
                                    Margin="4,4,0,0" />
                        </UniformGrid>
                        <ListBox ItemsSource="{Binding Profiles}"
                                 SelectedItem="{Binding SelectedProfile}"
                                 DisplayMemberPath="Name" />
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Column="1"
                              Width="10"
                              HorizontalAlignment="Stretch"
                              Background="Transparent"
                              ResizeBehavior="PreviousAndNext" />

                <Border Grid.Column="2" Style="{StaticResource PanelChromeStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="180" />
                            <RowDefinition Height="Auto" MaxHeight="160" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        DockPanel.Dock="Left"
                                        Margin="0,0,12,0">
                                <Border Style="{StaticResource AccentBarStyle}"
                                        Height="14"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Ui.ModLibrary}"
                                           Style="{StaticResource SectionLabelStyle}"
                                           VerticalAlignment="Center"
                                           Margin="0" />
                            </StackPanel>
                            <WrapPanel Orientation="Horizontal"
                                       HorizontalAlignment="Right"
                                       DockPanel.Dock="Right">
                                <Button Command="{Binding ImportDllCommand}"
                                        Margin="0,0,8,4"
                                        MinWidth="88">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="14" Height="14" Margin="0,0,6,0"
                                              Stretch="Uniform"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="{StaticResource IconImportGeometry}" />
                                        <TextBlock Text="{Binding Ui.ImportDll}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ImportZipCommand}"
                                        Margin="0,0,8,4"
                                        MinWidth="88">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="14" Height="14" Margin="0,0,6,0"
                                              Stretch="Uniform"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="{StaticResource IconImportGeometry}" />
                                        <TextBlock Text="{Binding Ui.ImportZip}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ImportFolderCommand}"
                                        Margin="0,0,0,4"
                                        MinWidth="88">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="14" Height="14" Margin="0,0,6,0"
                                              Stretch="Uniform"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="{StaticResource IconImportGeometry}" />
                                        <TextBlock Text="{Binding Ui.ImportFolder}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </DockPanel>

                        <DockPanel Grid.Row="1" Margin="0,0,0,8" LastChildFill="False">
                            <DockPanel Width="160" MinHeight="32" Margin="0,0,8,0" LastChildFill="True">
                                <Path Width="14" Height="14" Margin="0,0,6,0"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Fill="{StaticResource TextMutedBrush}"
                                      DockPanel.Dock="Left"
                                      Data="{StaticResource IconSearchGeometry}" />
                                <TextBox VerticalContentAlignment="Center"
                                         ToolTip="{Binding Ui.FilterSearch}"
                                         Text="{Binding LibrarySearchText, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                            <ComboBox Width="140" MinHeight="32" Margin="0,0,8,0"
                                      ToolTip="{Binding Ui.FilterCategory}"
                                      ItemsSource="{Binding LibraryCategoryFilterOptions}"
                                      SelectedItem="{Binding SelectedLibraryCategoryFilter}"
                                      DisplayMemberPath="Label" />
                            <ComboBox Width="120" MinHeight="32" Margin="0,0,8,0"
                                      ToolTip="{Binding Ui.FilterTag}"
                                      ItemsSource="{Binding LibraryAvailableTagOptions}"
                                      SelectedItem="{Binding SelectedLibraryTagFilter}"
                                      DisplayMemberPath="Label" />
                            <ComboBox Width="140" MinHeight="32" Margin="0,0,8,0"
                                      ToolTip="{Binding Ui.FilterSort}"
                                      ItemsSource="{Binding SortModeOptions}"
                                      SelectedItem="{Binding SelectedLibrarySortMode}"
                                      DisplayMemberPath="Label" />
                            <Button Content="{Binding Ui.EditModTaxonomy}"
                                    Command="{Binding EditLibraryModTaxonomyCommand}"
                                    MinHeight="32"
                                    MinWidth="120"
                                    Padding="12,8"
                                    Style="{StaticResource GhostButtonStyle}" />
                            <Button Command="{Binding ApplyProfileCommand}"
                                    MinHeight="32"
                                    MinWidth="96"
                                    Margin="8,0,0,0"
                                    Padding="12,8">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UseApplyAccent}" Value="True">
                                                <Setter Property="Background" Value="#FF2A2418" />
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentAmberBrush}" />
                                                <Setter Property="Foreground" Value="{StaticResource AccentAmberHotBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="14" Height="14" Margin="0,0,6,0"
                                          Stretch="Uniform"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="{StaticResource IconCheckGeometry}" />
                                    <TextBlock Text="{Binding Ui.ApplyProfile}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DockPanel>

                        <Grid Grid.Row="2" MinHeight="140">
                        <DataGrid x:Name="LibraryModsGrid"
                                  ItemsSource="{Binding LibraryModsView}"
                                  SelectedItem="{Binding SelectedLibraryMod}"
                                  SelectionMode="Extended"
                                  SelectionChanged="LibraryModsGrid_SelectionChanged"
                                  IsReadOnly="False"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="{Binding DataContext.Ui.ColumnEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Width="56">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{Binding DataContext.Ui.ColumnName, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Binding="{Binding DisplayName}"
                                                    IsReadOnly="True"
                                                    Width="*"
                                                    MinWidth="140" />
                                <DataGridTextColumn Header="{Binding DataContext.Ui.ColumnCategory, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Binding="{Binding EffectiveCategoryDisplay}"
                                                    IsReadOnly="True"
                                                    Width="100" />
                                <DataGridTextColumn Header="{Binding DataContext.Ui.ColumnAuthor, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Binding="{Binding Author}"
                                                    IsReadOnly="True"
                                                    Width="110"
                                                    MinWidth="80" />
                                  <DataGridTextColumn Header="{Binding DataContext.Ui.ColumnType, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Binding="{Binding TypeLabel}"
                                                    IsReadOnly="True"
                                                    Width="90" />
                                <DataGridTextColumn Header="{Binding DataContext.Ui.ColumnVersion, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Binding="{Binding Version}"
                                                    IsReadOnly="True"
                                                    Width="80" />
                                <DataGridTemplateColumn Header="{Binding DataContext.Ui.ColumnRisk, RelativeSource={RelativeSource AncestorType=Window}}" Width="88">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding HighRiskLabel}"
                                                    Command="{Binding DataContext.ToggleHighRiskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="10,6"
                                                    MinHeight="30"
                                                    FontSize="12"
                                                    ToolTip="{Binding DataContext.Ui.TipToggleHighRisk, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{Binding DataContext.Ui.ColumnLoader, RelativeSource={RelativeSource AncestorType=Window}}" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding RequiredMelonLoaderVersion}"
                                                       Foreground="{StaticResource WarnBrush}"
                                                       ToolTip="{Binding VersionWarningHint}"
                                                       VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="" Width="64">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding DataContext.Ui.ActionDelete, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Command="{Binding DataContext.DeleteModCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="10,6"
                                                    MinHeight="30"
                                                    FontSize="12"
                                                    ToolTip="{Binding DataContext.Ui.TipDeleteFromLibrary, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="{Binding Ui.LibraryEmptyHint}"
                                   Style="{StaticResource EmptyStateStyle}"
                                   Visibility="{Binding IsLibraryEmpty, Converter={StaticResource BoolToVis}}" />
                        </Grid>

                        <Border Grid.Row="3"
                                Margin="0,12,0,0"
                                Padding="0,10,0,0"
                                MaxHeight="160"
                                BorderBrush="{StaticResource SteelEdgeBrush}"
                                BorderThickness="0,1,0,0">
                            <StackPanel>
                                <Border Margin="0,0,0,10"
                                        Visibility="{Binding SelectedLibraryMod, Converter={StaticResource NullToVis}}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right"
                                                    VerticalAlignment="Top"
                                                    Margin="8,0,0,0">
                                            <Button Command="{Binding ReportLibraryModCommand}"
                                                    MinWidth="72"
                                                    Padding="10,6"
                                                    MinHeight="30"
                                                    FontSize="12"
                                                    Margin="0,0,0,6"
                                                    Style="{StaticResource GhostButtonStyle}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Width="14" Height="14" Margin="0,0,6,0"
                                                          Stretch="Uniform"
                                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          Data="{StaticResource IconFlagGeometry}" />
                                                    <TextBlock Text="{Binding Ui.Report}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Content="{Binding Ui.ActionCollapseDetail}"
                                                    Command="{Binding ClearLibraryModSelectionCommand}"
                                                    MinWidth="72"
                                                    Padding="10,6"
                                                    MinHeight="30"
                                                    FontSize="12"
                                                    Style="{StaticResource GhostButtonStyle}" />
                                        </StackPanel>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      MaxHeight="140">
                                            <DockPanel>
                                                <Image DockPanel.Dock="Left"
                                                       Source="{Binding SelectedLibraryMod.PreviewImage}"
                                                       MaxHeight="120"
                                                       MaxWidth="180"
                                                       Stretch="Uniform"
                                                       Margin="0,0,12,0"
                                                       Cursor="Hand"
                                                       ToolTip="{Binding Ui.PreviewImageHint}"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       MouseLeftButtonUp="ModPreviewImage_Click" />
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold"
                                                               FontSize="13"
                                                               TextWrapping="Wrap"
                                                               Foreground="{StaticResource TextPrimaryBrush}">
                                                        <Run Text="{Binding Ui.LabelName, Mode=OneWay}" />
                                                        <Run Text="：" />
                                                        <Run Text="{Binding SelectedLibraryMod.DisplayName, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Margin="0,4,0,0"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               FontSize="12"
                                                               TextWrapping="Wrap">
                                                        <Run Text="{Binding Ui.LabelAuthor, Mode=OneWay}" />
                                                        <Run Text="：" />
                                                        <Run Text="{Binding SelectedLibraryMod.Author, Mode=OneWay}" />
                                                        <Run Text="  ·  " />
                                                        <Run Text="{Binding Ui.LabelVersion, Mode=OneWay}" />
                                                        <Run Text="：" />
                                                        <Run Text="{Binding SelectedLibraryMod.Version, Mode=OneWay}" />
                                                        <Run Text="  ·  " />
                                                        <Run Text="{Binding Ui.LabelUpdated, Mode=OneWay}" />
                                                        <Run Text="：" />
                                                        <Run Text="{Binding SelectedLibraryMod.CatalogUpdatedAt, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Margin="0,6,0,0"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               FontSize="12"
                                                               TextWrapping="Wrap">
                                                        <Run Text="{Binding Ui.LabelSummary, Mode=OneWay}" />
                                                        <Run Text="：" />
                                                        <Run Text="{Binding SelectedLibraryMod.Summary, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Margin="0,6,0,0"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               FontSize="12"
                                                               TextWrapping="Wrap"
                                                               Visibility="{Binding SelectedLibraryMod.EffectiveTagsText, Converter={StaticResource NonEmptyVis}}">
                                                        <Run Text="{Binding Ui.TagsLabel, Mode=OneWay}" />
                                                        <Run Text="：" />
                                                        <Run Text="{Binding SelectedLibraryMod.EffectiveTagsText, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </DockPanel>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>
                                <TextBlock Text="{Binding DirtyHint}"
                                           Foreground="{StaticResource AccentTealBrush}"
                                           FontSize="12" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            </Grid><!-- ContentPagesHost -->

            <StackPanel Grid.Row="2" Margin="12,0,12,4">
                <Border Background="#FF241C12"
                        BorderBrush="{StaticResource DangerBrush}"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="12,8"
                        Margin="0,0,0,8"
                        Visibility="{Binding MissingEnabledPackagesWarning, Converter={StaticResource NonEmptyVis}}">
                    <TextBlock Text="{Binding MissingEnabledPackagesWarning}"
                               Foreground="{StaticResource AccentAmberHotBrush}"
                               TextWrapping="Wrap"
                               FontSize="12" />
                </Border>
                <Border Background="#FF241C12"
                        BorderBrush="{StaticResource WarnBrush}"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="12,8"
                        Visibility="{Binding LoaderVersionWarning, Converter={StaticResource NonEmptyVis}}">
                    <TextBlock Text="{Binding LoaderVersionWarning}"
                               Foreground="{StaticResource AccentAmberHotBrush}"
                               TextWrapping="Wrap"
                               FontSize="12" />
                </Border>
                <Border Background="#FF241C12"
                        BorderBrush="{StaticResource WarnBrush}"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="12,8"
                        Margin="0,8,0,0"
                        Visibility="{Binding FirstAssemblyWarning, Converter={StaticResource NonEmptyVis}}">
                    <TextBlock Text="{Binding FirstAssemblyWarning}"
                               Foreground="{StaticResource AccentAmberHotBrush}"
                               TextWrapping="Wrap"
                               FontSize="12" />
                </Border>
            </StackPanel>

            <Border Grid.Row="3"
                    Margin="12,0,12,4"
                    Background="{StaticResource RiskBannerBrush}"
                    BorderBrush="{StaticResource DangerBrush}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="12,10">
                <DockPanel>
                    <Border Style="{StaticResource AccentBarStyle}"
                            Background="{StaticResource DangerBrush}"
                            Height="Auto"
                            MinHeight="20"
                            Margin="0,0,10,0"
                            DockPanel.Dock="Left" />
                    <TextBlock Text="{Binding RiskBanner}"
                               TextWrapping="Wrap"
                               Foreground="#FFE8C8C0"
                               FontSize="12"
                               VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Border Grid.Row="4"
                    Margin="12,4,12,10"
                    Style="{StaticResource PanelChromeStyle}"
                    Background="#EE0E1114"
                    Padding="10,8"
                    x:Name="LogPanel">
                <DockPanel LastChildFill="True">
                    <!-- Header: title + expand/collapse -->
                    <Button DockPanel.Dock="Top"
                            Command="{Binding ToggleLogPanelCommand}"
                            Margin="0,0,0,0"
                            Padding="4,2"
                            HorizontalContentAlignment="Stretch"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="MinHeight" Value="28" />
                                <Setter Property="Padding" Value="4,2" />
                            </Style>
                        </Button.Style>
                        <DockPanel LastChildFill="True">
                            <Border Style="{StaticResource AccentBarStyle}"
                                    Height="12"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    DockPanel.Dock="Left" />
                            <Grid DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Ui.LogExpand}"
                                           Foreground="{StaticResource AccentAmberHotBrush}"
                                           FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLogExpanded}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Ui.LogCollapse}"
                                           Foreground="{StaticResource AccentAmberHotBrush}"
                                           FontSize="12"
                                           Visibility="{Binding IsLogExpanded, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                            <TextBlock Text="{Binding Ui.SyncLog}"
                                       Style="{StaticResource SectionLabelStyle}"
                                       Margin="0"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Button>

                    <!-- Collapsed: one-line preview -->
                        <TextBlock Margin="11,6,0,0"
                               FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI"
                               FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="{Binding LatestLogLine}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               MaxHeight="18"
                               ToolTip="{Binding LatestLogLine}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLogExpanded}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Expanded: large scrollable log -->
                    <Border Margin="0,8,0,0"
                            Background="#990A0D10"
                            BorderBrush="{StaticResource SteelBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="10,8"
                            MinHeight="200"
                            MaxHeight="360"
                            Visibility="{Binding IsLogExpanded, Converter={StaticResource BoolToVis}}">
                        <TextBox Text="{Binding LogText, Mode=OneWay}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI"
                                 FontSize="12"
                                 VerticalContentAlignment="Top"
                                 Foreground="{StaticResource TextMutedBrush}" />
                    </Border>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
