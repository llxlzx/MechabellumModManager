                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           MouseLeftButtonUp="ModPreviewImage_Click" />
                                </theme:ModePlate>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="160">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedCatalogMod.Name}"
