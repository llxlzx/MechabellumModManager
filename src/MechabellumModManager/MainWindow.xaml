<Window x:Class="MechabellumModManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:MechabellumModManager.Converters"
        mc:Ignorable="d"
        Title="钢铁指挥官 Mod 管理器"
        Height="740"
        Width="1200"
        MinHeight="600"
        MinWidth="780"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}">
    <Window.Resources>
        <conv:NonEmptyStringToVisibilityConverter x:Key="NonEmptyVis" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
    </Window.Resources>

    <Grid>
        <!-- Atmosphere (non-interactive) -->
        <Grid IsHitTestVisible="False">
            <Rectangle Fill="{StaticResource WindowBackgroundBrush}" />
            <Rectangle Fill="{StaticResource AtmosphereGlowBrush}" />
            <Rectangle Fill="{StaticResource GridOverlayBrush}" Opacity="0.35" />
            <Rectangle Fill="{StaticResource VignetteBrush}" />
        </Grid>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="120" MinHeight="80" />
            </Grid.RowDefinitions>

            <!-- Top: always two rows — brand/status, then profile/actions -->
            <Border Grid.Row="0"
                    Background="{StaticResource HeaderBarBrush}"
                    BorderBrush="{StaticResource SteelEdgeBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="16,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Row 1: brand + status -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="120" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="40"
                                    Height="40"
                                    CornerRadius="4"
                                    BorderBrush="{StaticResource SteelEdgeBrush}"
                                    BorderThickness="1"
                                    Background="#FF0C1014"
                                    Margin="0,0,12,0"
                                    SnapsToDevicePixels="True">
                                <Image x:Name="BrandImage"
                                       Stretch="Uniform"
                                       Margin="3"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <Border Style="{StaticResource AccentBarStyle}"
                                    Height="34"
                                    Margin="0,0,12,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="钢铁指挥官"
                                           Style="{StaticResource ShellTitleStyle}" />
                                <TextBlock Text="Mod 管理器 · Mechabellum"
                                           Style="{StaticResource ShellSubtitleStyle}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Background="#CC1E262E"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="12,7"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Stretch">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{StaticResource SteelEdgeBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsReady}" Value="False">
                                            <Setter Property="BorderBrush" Value="{StaticResource WarnBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsReady}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentTealBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding StatusKindLabel}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsReady}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentAmberHotBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding GameStatus.Message}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center"
                                           ToolTip="{Binding GameStatus.Message}" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Row 2: profile left, actions wrap right -->
                    <Border Grid.Row="1"
                            Margin="0,10,0,0"
                            Padding="0,10,0,0"
                            BorderBrush="{StaticResource SteelEdgeBrush}"
                            BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="0,0,12,0">
                                <TextBlock Text="{Binding Ui.CurrentProfile}"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Margin="0,0,8,0" />
                                <ComboBox MinWidth="120"
                                          Width="160"
                                          ItemsSource="{Binding Profiles}"
                                          SelectedItem="{Binding SelectedProfile}"
                                          DisplayMemberPath="Name"
                                          VerticalAlignment="Center" />
                            </StackPanel>

                            <WrapPanel Grid.Column="1"
                                       Orientation="Horizontal"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center">
                                <Button Content="{Binding Ui.ApplyProfile}"
                                        Command="{Binding ApplyProfileCommand}"
                                        IsEnabled="{Binding IsReady}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Margin="0,0,8,4"
                                        MinWidth="96"
                                        Padding="12,6" />
                                <Button Content="{Binding Ui.ApplyAndLaunch}"
                                        Command="{Binding ApplyAndLaunchCommand}"
                                        IsEnabled="{Binding IsReady}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Margin="0,0,8,4"
                                        MinWidth="108"
                                        Padding="12,6" />
                                <Button Content="{Binding Ui.BrowseMods}"
                                        Command="{Binding ToggleCatalogCommand}"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Margin="0,0,8,4"
                                        MinWidth="88"
                                        Padding="12,6" />
                                <Button Content="{Binding Ui.SubmitMod}"
                                        Command="{Binding SubmitModCommand}"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Margin="0,0,8,4"
                                        MinWidth="88"
                                        Padding="12,6" />
                                <Button Content="{Binding Ui.Settings}"
                                        Command="{Binding ToggleSettingsCommand}"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Margin="0,0,0,4"
                                        MinWidth="72"
                                        Padding="12,6" />
                            </WrapPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Settings strip -->
            <Border Grid.Row="1"
                    Background="#E0161B20"
                    BorderBrush="{StaticResource SteelEdgeBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="18,12"
                    Visibility="{Binding SettingsExpanded, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.ColumnSpan="3"
                               Text="{Binding Ui.Settings}"
                               Style="{StaticResource SectionLabelStyle}" />

                    <DockPanel Grid.Row="1" Margin="0,0,16,0">
                        <TextBlock Text="{Binding Ui.GamePath}"
                                   Width="72"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   DockPanel.Dock="Left" />
                        <Button Content="浏览…"
                                Command="{Binding BrowseGamePathCommand}"
                                DockPanel.Dock="Right"
                                Margin="8,0,0,0"
                                MinWidth="72" />
                        <TextBox Text="{Binding GamePath, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center" />
                    </DockPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="{Binding Ui.LaunchMode}"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,0,8,0" />
                        <ComboBox Width="150"
                                  ItemsSource="{Binding LaunchModeOptions}"
                                  SelectedValue="{Binding LaunchMode}"
                                  SelectedValuePath="Mode"
                                  DisplayMemberPath="Label" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="2" VerticalAlignment="Center">
                        <CheckBox Content="{Binding Ui.PortableDataRoot}"
                                  IsChecked="{Binding UsePortableDataRoot}" />
                    </StackPanel>

                    
                    <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,14,0,0">
                        <TextBlock Text="{Binding Ui.BranchSwitchTitle}"
                                   Style="{StaticResource SectionLabelStyle}"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="{Binding Ui.BranchSwitchHint}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,0,0,8" />
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="{Binding Ui.BranchSwitchStatus}"
                                       Width="120"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       DockPanel.Dock="Left"
                                       Margin="0,0,8,0" />
                            <TextBlock Text="{Binding BranchStatusText}"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="{Binding Ui.BranchSwitchBetaName}"
                                       Width="120"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       DockPanel.Dock="Left"
                                       Margin="0,0,8,0" />
                            <TextBox Text="{Binding BetaBranchName, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalAlignment="Center" />
                        </DockPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <DockPanel>
                                <TextBlock Text="{Binding Ui.BranchSwitchOfficialProfile}"
                                           Width="120"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           DockPanel.Dock="Left"
                                           Margin="0,0,8,0" />
                                <ComboBox ItemsSource="{Binding Profiles}"
                                          SelectedValue="{Binding OfficialProfileId}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="Name"
                                          VerticalAlignment="Center" />
                            </DockPanel>
                            <DockPanel Grid.Column="2">
                                <TextBlock Text="{Binding Ui.BranchSwitchBetaProfile}"
                                           Width="120"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           DockPanel.Dock="Left"
                                           Margin="0,0,8,0" />
                                <ComboBox ItemsSource="{Binding Profiles}"
                                          SelectedValue="{Binding BetaProfileId}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="Name"
                                          VerticalAlignment="Center" />
                            </DockPanel>
                        </Grid>
                        <WrapPanel>
                            <Button Content="{Binding Ui.BranchSwitchToOfficial}"
                                    Command="{Binding SwitchToOfficialCommand}"
                                    MinWidth="108"
                                    Margin="0,0,8,4"
                                    Padding="12,6">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                        <Setter Property="IsEnabled" Value="{Binding BranchSwitchEnabled}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBranchSwitchBusy}" Value="True">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="{Binding Ui.BranchSwitchToBeta}"
                                    Command="{Binding SwitchToBetaCommand}"
                                    MinWidth="108"
                                    Margin="0,0,8,4"
                                    Padding="12,6">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                        <Setter Property="IsEnabled" Value="{Binding BranchSwitchEnabled}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBranchSwitchBusy}" Value="True">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="{Binding Ui.BranchSwitchStartWizard}"
                                    Command="{Binding StartBranchWizardCommand}"
                                    Style="{StaticResource GhostButtonStyle}"
                                    MinWidth="120"
                                    Margin="0,0,8,4"
                                    Padding="12,6" />
                            <Button Content="{Binding Ui.BranchSwitchTeardown}"
                                    Command="{Binding TeardownBranchSwitchCommand}"
                                    IsEnabled="{Binding BranchSwitchEnabled}"
                                    Style="{StaticResource GhostButtonStyle}"
                                    MinWidth="120"
                                    Margin="0,0,8,4"
                                    Padding="12,6" />
                            <Button Content="{Binding Ui.BranchSwitchConfirmManual}"
                                    Command="{Binding ConfirmManualBetaCommand}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Visibility="{Binding ShowConfirmManualBeta, Converter={StaticResource BoolToVis}}"
                                    MinWidth="120"
                                    Margin="0,0,0,4"
                                    Padding="12,6" />
                        </WrapPanel>
                    </StackPanel>

                    <DockPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="0,10,0,0">
                        <TextBlock Text="{Binding AppVersion, StringFormat=版本 {0}}"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   DockPanel.Dock="Left"
                                   Margin="0,0,12,0" />
                        <Button Content="{Binding Ui.CheckUpdates}"
                                Command="{Binding CheckForUpdatesCommand}"
                                DockPanel.Dock="Left"
                                MinWidth="88"
                                Margin="0,0,12,0"
                                Style="{StaticResource GhostButtonStyle}" />
                        <Button Content="{Binding Ui.ImportFromGame}"
                                Command="{Binding ImportFromGameCommand}"
                                DockPanel.Dock="Left"
                                MinWidth="96"
                                Margin="0,0,12,0"
                                Style="{StaticResource GhostButtonStyle}" />
                        <TextBlock Text="{Binding Ui.Language}"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   DockPanel.Dock="Left"
                                   Margin="0,0,8,0" />
                        <ComboBox Width="140"
                                  ItemsSource="{Binding LanguageOptions}"
                                  SelectedValue="{Binding SelectedUiLanguageCode}"
                                  SelectedValuePath="Code"
                                  DisplayMemberPath="Label"
                                  DockPanel.Dock="Left"
                                  Margin="0,0,12,0"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="{Binding UpdateStatus}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </DockPanel>

                    <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Margin="0,14,0,0">
                        <TextBlock Text="{Binding Ui.CreditsTitle}"
                                   Style="{StaticResource SectionLabelStyle}"
                                   Margin="0,0,0,6" />
                        <TextBox Text="{Binding Ui.CreditsBody, Mode=OneWay}"
                                 Style="{StaticResource SelectableReadOnlyTextStyle}"
                                 FontSize="12"
                                 Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Catalog browser strip -->
            <Border Grid.Row="2"
                    Background="#E0161B20"
                    BorderBrush="{StaticResource SteelEdgeBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="18,12"
                    Visibility="{Binding CatalogExpanded, Converter={StaticResource BoolToVis}}">
                <DockPanel MaxHeight="420">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource AccentBarStyle}"
                                    Height="14"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Ui.BrowseMods}"
                                       Style="{StaticResource SectionLabelStyle}"
                                       Margin="0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    DockPanel.Dock="Right">
                            <Button Content="{Binding Ui.RefreshCatalog}"
                                    Command="{Binding RefreshCatalogCommand}"
                                    Margin="0,0,8,0"
                                    MinWidth="88"
                                    Style="{StaticResource GhostButtonStyle}" />
                            <Button Content="{Binding Ui.AddToLibrary}"
                                    Command="{Binding AddCatalogModToLibraryCommand}"
                                    MinWidth="96"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource AccentButtonStyle}" />
                            <Button Content="{Binding Ui.Report}"
                                    Command="{Binding ReportCatalogModCommand}"
                                    MinWidth="72"
                                    Style="{StaticResource GhostButtonStyle}" />
                        </StackPanel>
                    </DockPanel>

                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
                        <TextBox Width="160" Height="28" Margin="0,0,8,0"
                                 VerticalContentAlignment="Center"
                                 ToolTip="{Binding Ui.FilterSearch}"
                                 Text="{Binding CatalogSearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox Width="140" Height="28" Margin="0,0,8,0"
                                  ToolTip="{Binding Ui.FilterCategory}"
                                  ItemsSource="{Binding CatalogCategoryFilterOptions}"
                                  SelectedItem="{Binding SelectedCatalogCategoryFilter}"
                                  DisplayMemberPath="Label" />
                        <ComboBox Width="120" Height="28" Margin="0,0,8,0"
                                  ToolTip="{Binding Ui.FilterTag}"
                                  ItemsSource="{Binding CatalogAvailableTagOptions}"
                                  SelectedItem="{Binding SelectedCatalogTagFilter}"
                                  DisplayMemberPath="Label" />
                        <ComboBox Width="140" Height="28"
                                  ToolTip="{Binding Ui.FilterSort}"
                                  ItemsSource="{Binding SortModeOptions}"
                                  SelectedItem="{Binding SelectedCatalogSortMode}"
                                  DisplayMemberPath="Label" />
                    </DockPanel>

                    <TextBlock DockPanel.Dock="Bottom"
                               Margin="0,8,0,0"
                               Text="{Binding CatalogStatus}"
                               Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               FontSize="12" />

                    <Border DockPanel.Dock="Bottom"
                            Margin="0,10,0,0"
                            Padding="0,10,0,0"
                            BorderBrush="{StaticResource SteelEdgeBrush}"
                            BorderThickness="0,1,0,0"
                            Visibility="{Binding SelectedCatalogMod, Converter={StaticResource NullToVis}}">
                        <DockPanel>
                            <Image DockPanel.Dock="Left"
                                   Source="{Binding SelectedCatalogMod.PreviewImage}"
                                   MaxHeight="160"
                                   MaxWidth="240"
                                   Stretch="Uniform"
                                   Margin="0,0,14,0"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedCatalogMod.Name}"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap">
                                    <Run Text="作者：" />
                                    <Run Text="{Binding SelectedCatalogMod.Author, Mode=OneWay}" />
                                    <Run Text="  ·  版本：" />
                                    <Run Text="{Binding SelectedCatalogMod.Version, Mode=OneWay}" />
                                    <Run Text="  ·  更新：" />
                                    <Run Text="{Binding SelectedCatalogMod.UpdatedAt, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Margin="0,8,0,0"
                                           Text="{Binding SelectedCatalogMod.Summary}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           TextWrapping="Wrap"
                                           FontSize="12" />
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding SelectedCatalogMod.EffectiveTagsText, Converter={StaticResource NonEmptyVis}}">
                                    <Run Text="{Binding Ui.TagsLabel, Mode=OneWay}" />
                                    <Run Text="：" />
                                    <Run Text="{Binding SelectedCatalogMod.EffectiveTagsText, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <DataGrid ItemsSource="{Binding CatalogModsView}"
                              SelectedItem="{Binding SelectedCatalogMod}"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              MaxHeight="180">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称"
                                                Binding="{Binding Name}"
                                                Width="*"
                                                MinWidth="120" />
                            <DataGridTextColumn Header="{Binding DataContext.Ui.ColumnCategory, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Binding="{Binding EffectiveCategoryDisplay}"
                                                Width="100" />
                            <DataGridTextColumn Header="作者"
                                                Binding="{Binding Author}"
                                                Width="90" />
                            <DataGridTextColumn Header="版本"
                                                Binding="{Binding Version}"
                                                Width="70" />
                            <DataGridTextColumn Header="更新"
                                                Binding="{Binding UpdatedAt}"
                                                Width="100" />
                            <DataGridTextColumn Header="状态"
                                                Binding="{Binding StatusText}"
                                                Width="72" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Body: profiles | library -->
            <Grid Grid.Row="3" Margin="18,14,18,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="252" MinWidth="200" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" MinWidth="420" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource PanelChromeStyle}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Style="{StaticResource AccentBarStyle}"
                                    Height="14"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Ui.Profiles}"
                                       Style="{StaticResource SectionLabelStyle}"
                                       Margin="0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <UniformGrid Rows="2" Columns="2"
                                     DockPanel.Dock="Bottom"
                                     Margin="0,12,0,0">
                            <Button Content="新建"
                                    Command="{Binding CreateProfileCommand}"
                                    Margin="0,0,4,4" />
                            <Button Content="重命名"
                                    Command="{Binding RenameProfileCommand}"
                                    Margin="4,0,0,4" />
                            <Button Content="复制"
                                    Command="{Binding DuplicateProfileCommand}"
                                    Margin="0,4,4,0" />
                            <Button Content="删除"
                                    Command="{Binding DeleteProfileCommand}"
                                    Margin="4,4,0,0" />
                        </UniformGrid>
                        <ListBox ItemsSource="{Binding Profiles}"
                                 SelectedItem="{Binding SelectedProfile}"
                                 DisplayMemberPath="Name" />
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Column="1"
                              Width="10"
                              HorizontalAlignment="Stretch"
                              Background="Transparent"
                              ResizeBehavior="PreviousAndNext" />

                <Border Grid.Column="2" Style="{StaticResource PanelChromeStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="140" />
                            <RowDefinition Height="Auto" MaxHeight="180" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        DockPanel.Dock="Left"
                                        Margin="0,0,12,0">
                                <Border Style="{StaticResource AccentBarStyle}"
                                        Height="14"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Ui.ModLibrary}"
                                           Style="{StaticResource SectionLabelStyle}"
                                           VerticalAlignment="Center"
                                           Margin="0" />
                            </StackPanel>
                            <WrapPanel Orientation="Horizontal"
                                       HorizontalAlignment="Right"
                                       DockPanel.Dock="Right">
                                <Button Content="{Binding Ui.ImportDll}"
                                        Command="{Binding ImportDllCommand}"
                                        Margin="0,0,8,4"
                                        MinWidth="88" />
                                <Button Content="{Binding Ui.ImportZip}"
                                        Command="{Binding ImportZipCommand}"
                                        Margin="0,0,8,4"
                                        MinWidth="88" />
                                <Button Content="{Binding Ui.ImportFolder}"
                                        Command="{Binding ImportFolderCommand}"
                                        Margin="0,0,0,4"
                                        MinWidth="88" />
                            </WrapPanel>
                        </DockPanel>

                        <DockPanel Grid.Row="1" Margin="0,0,0,8" LastChildFill="False">
                            <TextBox Width="160" Height="28" Margin="0,0,8,0"
                                     VerticalContentAlignment="Center"
                                     ToolTip="{Binding Ui.FilterSearch}"
                                     Text="{Binding LibrarySearchText, UpdateSourceTrigger=PropertyChanged}" />
                            <ComboBox Width="140" Height="28" Margin="0,0,8,0"
                                      ToolTip="{Binding Ui.FilterCategory}"
                                      ItemsSource="{Binding LibraryCategoryFilterOptions}"
                                      SelectedItem="{Binding SelectedLibraryCategoryFilter}"
                                      DisplayMemberPath="Label" />
                            <ComboBox Width="120" Height="28" Margin="0,0,8,0"
                                      ToolTip="{Binding Ui.FilterTag}"
                                      ItemsSource="{Binding LibraryAvailableTagOptions}"
                                      SelectedItem="{Binding SelectedLibraryTagFilter}"
                                      DisplayMemberPath="Label" />
                            <ComboBox Width="140" Height="28" Margin="0,0,8,0"
                                      ToolTip="{Binding Ui.FilterSort}"
                                      ItemsSource="{Binding SortModeOptions}"
                                      SelectedItem="{Binding SelectedLibrarySortMode}"
                                      DisplayMemberPath="Label" />
                            <Button Content="{Binding Ui.EditModTaxonomy}"
                                    Command="{Binding EditLibraryModTaxonomyCommand}"
                                    Height="28"
                                    MinWidth="110"
                                    Style="{StaticResource GhostButtonStyle}" />
                        </DockPanel>

                        <DataGrid Grid.Row="2"
                                  ItemsSource="{Binding LibraryModsView}"
                                  SelectedItem="{Binding SelectedLibraryMod}"
                                  IsReadOnly="False"
                                  HeadersVisibility="Column"
                                  MinHeight="140">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="启用" Width="56">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="名称"
                                                    Binding="{Binding DisplayName}"
                                                    IsReadOnly="True"
                                                    Width="*"
                                                    MinWidth="140" />
                                <DataGridTextColumn Header="{Binding DataContext.Ui.ColumnCategory, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Binding="{Binding EffectiveCategoryDisplay}"
                                                    IsReadOnly="True"
                                                    Width="100" />
                                <DataGridTextColumn Header="作者"
                                                    Binding="{Binding Author}"
                                                    IsReadOnly="True"
                                                    Width="110"
                                                    MinWidth="80" />
                                  <DataGridTextColumn Header="类型"
                                                    Binding="{Binding TypeLabel}"
                                                    IsReadOnly="True"
                                                    Width="90" />
                                <DataGridTextColumn Header="版本"
                                                    Binding="{Binding Version}"
                                                    IsReadOnly="True"
                                                    Width="80" />
                                <DataGridTemplateColumn Header="风险" Width="88">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding HighRiskLabel}"
                                                    Command="{Binding DataContext.ToggleHighRiskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="6,2"
                                                    FontSize="11"
                                                    ToolTip="点击临时切换；刷新后按名称关键词重算" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="加载器" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding RequiredMelonLoaderVersion}"
                                                       Foreground="{StaticResource WarnBrush}"
                                                       ToolTip="{Binding VersionWarningHint}"
                                                       VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="" Width="64">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="删除"
                                                    Command="{Binding DataContext.DeleteModCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="6,2"
                                                    FontSize="11"
                                                    ToolTip="从库中删除此包" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Grid.Row="3"
                                Margin="0,12,0,0"
                                Padding="0,10,0,0"
                                MaxHeight="160"
                                BorderBrush="{StaticResource SteelEdgeBrush}"
                                BorderThickness="0,1,0,0">
                            <StackPanel>
                                <Border Margin="0,0,0,10"
                                        Visibility="{Binding SelectedLibraryMod, Converter={StaticResource NullToVis}}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right"
                                                    VerticalAlignment="Top"
                                                    Margin="8,0,0,0">
                                            <Button Content="{Binding Ui.Report}"
                                                    Command="{Binding ReportLibraryModCommand}"
                                                    MinWidth="72"
                                                    Padding="8,2"
                                                    FontSize="11"
                                                    Margin="0,0,0,6"
                                                    Style="{StaticResource GhostButtonStyle}" />
                                            <Button Content="收起介绍"
                                                    Command="{Binding ClearLibraryModSelectionCommand}"
                                                    MinWidth="72"
                                                    Padding="8,2"
                                                    FontSize="11"
                                                    Style="{StaticResource GhostButtonStyle}" />
                                        </StackPanel>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      MaxHeight="140">
                                            <DockPanel>
                                                <Image DockPanel.Dock="Left"
                                                       Source="{Binding SelectedLibraryMod.PreviewImage}"
                                                       MaxHeight="120"
                                                       MaxWidth="180"
                                                       Stretch="Uniform"
                                                       Margin="0,0,12,0"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold"
                                                               FontSize="13"
                                                               TextWrapping="Wrap"
                                                               Foreground="{StaticResource TextPrimaryBrush}">
                                                        <Run Text="名称：" />
                                                        <Run Text="{Binding SelectedLibraryMod.DisplayName, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Margin="0,4,0,0"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               FontSize="12"
                                                               TextWrapping="Wrap">
                                                        <Run Text="作者：" />
                                                        <Run Text="{Binding SelectedLibraryMod.Author, Mode=OneWay}" />
                                                        <Run Text="  ·  版本：" />
                                                        <Run Text="{Binding SelectedLibraryMod.Version, Mode=OneWay}" />
                                                        <Run Text="  ·  更新：" />
                                                        <Run Text="{Binding SelectedLibraryMod.CatalogUpdatedAt, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Margin="0,6,0,0"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               FontSize="12"
                                                               TextWrapping="Wrap">
                                                        <Run Text="功能：" />
                                                        <Run Text="{Binding SelectedLibraryMod.Summary, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Margin="0,6,0,0"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               FontSize="12"
                                                               TextWrapping="Wrap"
                                                               Visibility="{Binding SelectedLibraryMod.EffectiveTagsText, Converter={StaticResource NonEmptyVis}}">
                                                        <Run Text="{Binding Ui.TagsLabel, Mode=OneWay}" />
                                                        <Run Text="：" />
                                                        <Run Text="{Binding SelectedLibraryMod.EffectiveTagsText, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </DockPanel>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>
                                <TextBlock Text="{Binding DirtyHint}"
                                           Foreground="{StaticResource AccentTealBrush}"
                                           FontSize="12" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <StackPanel Grid.Row="4" Margin="18,0,18,8">
                <Border Background="#FF241C12"
                        BorderBrush="{StaticResource DangerBrush}"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="12,8"
                        Margin="0,0,0,8"
                        Visibility="{Binding MissingEnabledPackagesWarning, Converter={StaticResource NonEmptyVis}}">
                    <TextBlock Text="{Binding MissingEnabledPackagesWarning}"
                               Foreground="{StaticResource AccentAmberHotBrush}"
                               TextWrapping="Wrap"
                               FontSize="12" />
                </Border>
                <Border Background="#FF241C12"
                        BorderBrush="{StaticResource WarnBrush}"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="12,8"
                        Visibility="{Binding LoaderVersionWarning, Converter={StaticResource NonEmptyVis}}">
                    <TextBlock Text="{Binding LoaderVersionWarning}"
                               Foreground="{StaticResource AccentAmberHotBrush}"
                               TextWrapping="Wrap"
                               FontSize="12" />
                </Border>
                <Border Background="#FF241C12"
                        BorderBrush="{StaticResource WarnBrush}"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="12,8"
                        Margin="0,8,0,0"
                        Visibility="{Binding FirstAssemblyWarning, Converter={StaticResource NonEmptyVis}}">
                    <TextBlock Text="{Binding FirstAssemblyWarning}"
                               Foreground="{StaticResource AccentAmberHotBrush}"
                               TextWrapping="Wrap"
                               FontSize="12" />
                </Border>
            </StackPanel>

            <Border Grid.Row="5"
                    Margin="18,0,18,8"
                    Background="{StaticResource RiskBannerBrush}"
                    BorderBrush="{StaticResource DangerBrush}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="12,10">
                <DockPanel>
                    <Border Style="{StaticResource AccentBarStyle}"
                            Background="{StaticResource DangerBrush}"
                            Height="Auto"
                            MinHeight="20"
                            Margin="0,0,10,0"
                            DockPanel.Dock="Left" />
                    <TextBlock Text="{Binding RiskBanner}"
                               TextWrapping="Wrap"
                               Foreground="#FFE8C8C0"
                               FontSize="12"
                               VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Border Grid.Row="6"
                    Margin="18,0,18,14"
                    Style="{StaticResource PanelChromeStyle}"
                    Background="#EE0E1114"
                    Padding="14">
                <DockPanel>
                    <TextBlock Text="{Binding Ui.SyncLog}"
                               Style="{StaticResource SectionLabelStyle}"
                               DockPanel.Dock="Top" />
                    <TextBox Text="{Binding LogText, Mode=OneWay}"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             Background="Transparent"
                             BorderThickness="0"
                             FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI"
                             FontSize="12"
                             Foreground="{StaticResource TextMutedBrush}" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
