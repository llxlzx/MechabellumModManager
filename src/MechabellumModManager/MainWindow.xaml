                                  CanUserSortColumns="True"
                                  IsReadOnly="False"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="{Binding Data.Ui.ColumnEnabled, Source={StaticResource Proxy}}"
                                                        Width="78"
                                                        MinWidth="72"
                                                        SortMemberPath="IsEnabled">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{Binding Data.Ui.ColumnName, Source={StaticResource Proxy}}"
                                                    Binding="{Binding DisplayName}"
