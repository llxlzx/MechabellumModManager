                            <StackPanel DockPanel.Dock="Right"
                                        VerticalAlignment="Top"
                                        Margin="8,0,0,0">
                                <Button Command="{Binding ReportCatalogModCommand}"
                                        MinWidth="72"
                                        Padding="10,6"
                                        MinHeight="30"
                                        FontSize="13"
                                        Margin="0,0,0,6"
                                        Style="{StaticResource GhostButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="14" Height="14" Margin="0,0,6,0"
                                              Stretch="Uniform"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="{StaticResource IconFlagGeometry}" />
                                        <TextBlock Text="{Binding Ui.Report}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Content="{Binding Ui.ActionCollapseDetail}"
                                        Command="{Binding ClearCatalogModSelectionCommand}"
                                        MinWidth="72"
                                        Padding="10,6"
                                        MinHeight="30"
                                        FontSize="13"
                                        Style="{StaticResource GhostButtonStyle}" />
                            </StackPanel>
                            <DockPanel>
                                <theme:ModePlate DockPanel.Dock="Left"
                                                 Width="188"
                                                 Height="120"
                                                 Margin="0,0,14,0"
