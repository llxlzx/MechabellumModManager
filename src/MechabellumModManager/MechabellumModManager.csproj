<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>MechabellumModManager</AssemblyName>
    <Product>钢铁指挥官 Mod 管理器</Product>
    <AssemblyTitle>钢铁指挥官 Mod 管理器</AssemblyTitle>
    <Description>Mechabellum MelonLoader Mod 管理器</Description>
    <Version>1.0.0</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\brand.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\brand-256.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
