<Window x:Class="MechabellumModManager.Dialogs.BusyProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="Height"
        Width="420"
        MinWidth="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BgPanelBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}">
    <Border Padding="20"
            BorderBrush="{StaticResource SteelEdgeBrush}"
            BorderThickness="1">
        <StackPanel>
            <TextBlock x:Name="TitleText"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10"
                       Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock x:Name="MessageText"
                       TextWrapping="Wrap"
                       FontSize="14"
                       LineHeight="22"
                       Margin="0,0,0,16"
                       Foreground="{StaticResource TextPrimaryBrush}" />
            <ProgressBar Height="6"
                         IsIndeterminate="True"
                         Background="{StaticResource BgElevatedBrush}"
                         Foreground="{StaticResource AccentAmberBrush}"
                         BorderThickness="0" />
        </StackPanel>
    </Border>
</Window>
