<Window x:Class="MechabellumModManager.Dialogs.ExportDiagnosticsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="Height"
        Width="520"
        MinWidth="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BgPanelBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}">
    <Border Padding="20"
            BorderBrush="{StaticResource SteelEdgeBrush}"
            BorderThickness="1">
        <DockPanel>
            <StackPanel DockPanel.Dock="Bottom"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,18,0,0">
                <Button x:Name="OkButton"
                        MinWidth="108"
                        MinHeight="32"
                        Margin="0,0,8,0"
                        IsDefault="True"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="Ok_Click" />
                <Button x:Name="CancelButton"
                        MinWidth="96"
                        MinHeight="32"
                        IsCancel="True"
                        Click="Cancel_Click" />
            </StackPanel>
            <StackPanel>
                <TextBlock x:Name="TitleHint"
                           FontWeight="SemiBold"
                           FontSize="14"
                           Margin="0,0,0,10"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="ConsentText"
                           TextWrapping="Wrap"
                           FontSize="13"
                           LineHeight="20"
                           Foreground="{StaticResource TextMutedBrush}"
                           Margin="0,0,0,14" />
                <RadioButton x:Name="ModeFull"
                             GroupName="Redaction"
                             IsChecked="True"
                             Margin="0,0,0,8"
                             Foreground="{StaticResource TextPrimaryBrush}" />
                <RadioButton x:Name="ModeStrong"
                             GroupName="Redaction"
                             Margin="0,0,0,4"
                             Foreground="{StaticResource TextPrimaryBrush}" />
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
