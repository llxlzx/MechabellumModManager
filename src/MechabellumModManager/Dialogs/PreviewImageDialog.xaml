<Window x:Class="MechabellumModManager.Dialogs.PreviewImageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#E6000000"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        KeyDown="Window_KeyDown"
        MouseLeftButtonDown="Close_Click">
    <Grid Margin="24">
        <Border Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource SteelEdgeBrush}"
                BorderThickness="1"
                Padding="12"
                MaxWidth="960"
                MaxHeight="720"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MouseLeftButtonDown="Close_Click">
            <DockPanel>
                <TextBlock x:Name="HintText"
                           DockPanel.Dock="Bottom"
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center"
                           FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}" />
                <Image x:Name="Preview"
                       Stretch="Uniform"
                       MaxWidth="920"
                       MaxHeight="640"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
