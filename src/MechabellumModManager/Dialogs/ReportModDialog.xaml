<Window x:Class="MechabellumModManager.Dialogs.ReportModDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="举报"
        SizeToContent="Height"
        Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgPanelBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}">
    <Border Padding="20"
            BorderBrush="{StaticResource SteelEdgeBrush}"
            BorderThickness="1">
        <StackPanel>
            <TextBlock x:Name="ModLabel"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"
                       FontWeight="SemiBold" />
            <RadioButton x:Name="CatCheat"
                         GroupName="ReportCat"
                         Margin="0,0,0,6"
                         IsChecked="True" />
            <RadioButton x:Name="CatVirus"
                         GroupName="ReportCat"
                         Margin="0,0,0,6" />
            <RadioButton x:Name="CatUnrelated"
                         GroupName="ReportCat"
                         Margin="0,0,0,6" />
            <RadioButton x:Name="CatOther"
                         GroupName="ReportCat"
                         Margin="0,0,0,8"
                         Checked="Category_Changed"
                         Unchecked="Category_Changed" />
            <TextBlock x:Name="OtherHint"
                       Margin="0,0,0,6"
                       Foreground="{StaticResource TextMutedBrush}"
                       Visibility="Collapsed" />
            <TextBox x:Name="NotesBox"
                     Height="72"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     Visibility="Collapsed"
                     Background="{StaticResource BgElevatedBrush}"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     BorderBrush="{StaticResource SteelEdgeBrush}"
                     CaretBrush="{StaticResource AccentAmberBrush}" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0">
                <Button x:Name="CancelButton"
                        Width="88"
                        Height="30"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Click="Cancel_Click" />
                <Button x:Name="OkButton"
                        Width="88"
                        Height="30"
                        IsDefault="True"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="Ok_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
