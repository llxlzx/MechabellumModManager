<Window x:Class="MechabellumModManager.Dialogs.CriticalOpRecoveryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="Height"
        Width="560"
        MinWidth="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BgPanelBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}">
    <Border Padding="20"
            BorderBrush="{StaticResource SteelEdgeBrush}"
            BorderThickness="1">
        <DockPanel>
            <DockPanel DockPanel.Dock="Bottom"
                       Margin="0,18,0,0">
                <Button x:Name="DiagnosticsButton"
                        DockPanel.Dock="Left"
                        MinWidth="120"
                        MinHeight="32"
                        HorizontalAlignment="Left"
                        Click="Diagnostics_Click" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="AbandonButton"
                            MinWidth="120"
                            MinHeight="32"
                            Margin="0,0,8,0"
                            Click="Abandon_Click" />
                    <Button x:Name="RepairButton"
                            MinWidth="132"
                            MinHeight="32"
                            Margin="0,0,8,0"
                            Click="Repair_Click" />
                    <Button x:Name="ContinueButton"
                            MinWidth="132"
                            MinHeight="32"
                            IsDefault="True"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="Continue_Click" />
                </StackPanel>
            </DockPanel>
            <StackPanel>
                <TextBlock x:Name="TitleHint"
                           FontWeight="SemiBold"
                           FontSize="15"
                           Margin="0,0,0,10"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock x:Name="BodyText"
                           TextWrapping="Wrap"
                           FontSize="14"
                           LineHeight="22"
                           Foreground="{StaticResource TextPrimaryBrush}" />
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
