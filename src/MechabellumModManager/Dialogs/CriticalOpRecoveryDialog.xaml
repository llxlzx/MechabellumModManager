<Window x:Class="MechabellumModManager.Dialogs.CriticalOpRecoveryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="Height"
        Width="640"
        MinWidth="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BgPanelBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}">
    <Border Padding="20"
            BorderBrush="{StaticResource SteelEdgeBrush}"
            BorderThickness="1">
        <DockPanel>
            <WrapPanel DockPanel.Dock="Bottom"
                       Margin="0,18,0,0">
                <Button x:Name="DiagnosticsButton"
                        MinHeight="32"
                        Padding="12,8"
                        Margin="0,0,8,8"
                        Click="Diagnostics_Click" />
                <Button x:Name="AbandonButton"
                        MinHeight="32"
                        Padding="12,8"
                        Margin="0,0,8,8"
                        Click="Abandon_Click" />
                <Button x:Name="RepairButton"
                        MinHeight="32"
                        Padding="12,8"
                        Margin="0,0,8,8"
                        Click="Repair_Click" />
                <Button x:Name="ContinueButton"
                        MinHeight="32"
                        Padding="12,8"
                        Margin="0,0,0,8"
                        IsDefault="True"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="Continue_Click" />
            </WrapPanel>
            <StackPanel>
                <TextBlock x:Name="TitleHint"
                           FontWeight="SemiBold"
                           FontSize="15"
                           Margin="0,0,0,10"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock x:Name="BodyText"
                           TextWrapping="Wrap"
                           FontSize="14"
                           LineHeight="22"
                           Foreground="{StaticResource TextPrimaryBrush}" />
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
