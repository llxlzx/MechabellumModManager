<Window x:Class="MechabellumModManager.Dialogs.EditModTaxonomyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑分类/标签"
        SizeToContent="Height"
        Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgPanelBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}">
    <Border Padding="20"
            BorderBrush="{StaticResource SteelEdgeBrush}"
            BorderThickness="1">
        <StackPanel>
            <TextBlock x:Name="PromptText"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"
                       Foreground="{StaticResource TextMutedBrush}" />
            <TextBlock x:Name="CategoryLabel"
                       Text="分类"
                       Margin="0,0,0,4"
                       FontSize="12"
                       Foreground="{StaticResource TextMutedBrush}" />
            <ComboBox x:Name="CategoryCombo"
                      Height="32"
                      SelectedIndex="0" />
            <TextBlock x:Name="ExtraTagsLabel"
                       Text="额外标签（逗号分隔）"
                       Margin="0,12,0,4"
                       FontSize="12"
                       Foreground="{StaticResource TextMutedBrush}" />
            <TextBox x:Name="ExtraTagsBox"
                     Height="32"
                     VerticalContentAlignment="Center" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0">
                <Button x:Name="CancelButton"
                        Content="取消"
                        Width="88"
                        MinHeight="32"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Click="Cancel_Click" />
                <Button x:Name="OkButton"
                        Content="确定"
                        Width="88"
                        MinHeight="32"
                        IsDefault="True"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="Ok_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
