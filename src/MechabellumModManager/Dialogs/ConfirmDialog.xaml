<Window x:Class="MechabellumModManager.Dialogs.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="Height"
        Width="460"
        MinWidth="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BgPanelBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}">
    <Border Padding="20"
            BorderBrush="{StaticResource SteelEdgeBrush}"
            BorderThickness="1">
        <DockPanel>
            <StackPanel DockPanel.Dock="Bottom"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,18,0,0">
                <Button x:Name="YesButton"
                        MinWidth="96"
                        MinHeight="32"
                        Margin="0,0,8,0"
                        Click="Yes_Click" />
                <Button x:Name="NoButton"
                        MinWidth="96"
                        MinHeight="32"
                        Click="No_Click" />
            </StackPanel>
            <StackPanel>
                <TextBlock x:Name="MessageText"
                           TextWrapping="Wrap"
                           FontSize="14"
                           LineHeight="22"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <CheckBox x:Name="OptionCheck"
                          Visibility="Collapsed"
                          Margin="0,12,0,0"
                          Foreground="{StaticResource TextPrimaryBrush}" />
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
