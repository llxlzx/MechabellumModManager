<Window x:Class="MechabellumModManager.Dialogs.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="Height"
        Width="460"
        MinWidth="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BgPanelBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}">
    <Border Padding="20"
            BorderBrush="{StaticResource SteelEdgeBrush}"
            BorderThickness="1">
        <DockPanel>
            <StackPanel DockPanel.Dock="Bottom"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,18,0,0">
                <Button x:Name="NoButton"
                        MinWidth="96"
                        MinHeight="32"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Click="No_Click" />
                <Button x:Name="YesButton"
                        MinWidth="96"
                        MinHeight="32"
                        IsDefault="True"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="Yes_Click" />
            </StackPanel>
            <TextBlock x:Name="MessageText"
                       TextWrapping="Wrap"
                       FontSize="14"
                       LineHeight="22"
                       Foreground="{StaticResource TextPrimaryBrush}" />
        </DockPanel>
    </Border>
</Window>
