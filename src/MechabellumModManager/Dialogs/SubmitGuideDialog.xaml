<Window x:Class="MechabellumModManager.Dialogs.SubmitGuideDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="投稿 Mod"
        SizeToContent="Height"
        Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgPanelBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}">
    <Border Padding="20"
            BorderBrush="{StaticResource SteelEdgeBrush}"
            BorderThickness="1">
        <StackPanel>
            <TextBlock x:Name="IntroText"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"
                       Foreground="{StaticResource TextMutedBrush}" />
            <TextBlock x:Name="Step1Text"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8" />
            <TextBlock x:Name="Step2Text"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8" />
            <TextBlock x:Name="Step3Text"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="CancelButton"
                        Width="88"
                        Height="30"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Click="Cancel_Click" />
                <Button x:Name="OkButton"
                        Width="120"
                        Height="30"
                        IsDefault="True"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="Ok_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
