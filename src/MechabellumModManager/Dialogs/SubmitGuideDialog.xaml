<Window x:Class="MechabellumModManager.Dialogs.SubmitGuideDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="投稿步骤"
        Width="560"
        MaxHeight="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgPanelBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}">
    <Border Padding="20"
            BorderBrush="{StaticResource SteelEdgeBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          MaxHeight="420"
                          Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock x:Name="IntroText"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"
                               Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock x:Name="Step1Text"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10" />
                    <TextBlock x:Name="Step2Text"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10" />
                    <TextBlock x:Name="Step3Text"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10" />
                    <TextBlock x:Name="Step4Text"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10" />
                    <TextBlock x:Name="Step5Text"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12" />
                    <TextBlock x:Name="TipText"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource AccentAmberBrush}" />
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="CancelButton"
                        Width="88"
                        Height="30"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Click="Cancel_Click" />
                <Button x:Name="OkButton"
                        MinWidth="140"
                        Height="30"
                        Padding="12,0"
                        IsDefault="True"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="Ok_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
