<Window x:Class="MechabellumModManager.Dialogs.DirectUploadDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding TitleText}"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgPanelBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}">
    <Border Padding="20"
            BorderBrush="{StaticResource SteelEdgeBrush}"
            BorderThickness="1">
        <StackPanel>
            <TextBlock Text="{Binding InviteLabel}" Margin="0,0,0,4" Foreground="{StaticResource TextMutedBrush}" />
            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right"
                        MinWidth="88"
                        MinHeight="36"
                        Margin="8,0,0,0"
                        Content="{Binding SaveCodeLabel}"
                        Click="SaveCode_Click" />
                <TextBox x:Name="InviteBox" MinHeight="36" VerticalContentAlignment="Center" />
            </DockPanel>

            <TextBlock Text="{Binding ModIdLabel}" Margin="0,0,0,4" Foreground="{StaticResource TextMutedBrush}" />
            <TextBox x:Name="IdBox" MinHeight="36" Margin="0,0,0,8" VerticalContentAlignment="Center" />

            <TextBlock Text="{Binding NameLabel}" Margin="0,0,0,4" Foreground="{StaticResource TextMutedBrush}" />
            <TextBox x:Name="NameBox" MinHeight="36" Margin="0,0,0,8" VerticalContentAlignment="Center" />

            <TextBlock Text="{Binding SummaryLabel}" Margin="0,0,0,4" Foreground="{StaticResource TextMutedBrush}" />
            <TextBox x:Name="SummaryBox" MinHeight="56" Margin="0,0,0,8" TextWrapping="Wrap" AcceptsReturn="True" />

            <TextBlock Text="{Binding VersionLabel}" Margin="0,0,0,4" Foreground="{StaticResource TextMutedBrush}" />
            <TextBox x:Name="VersionBox" MinHeight="36" Margin="0,0,0,8" VerticalContentAlignment="Center" />

            <TextBlock Text="{Binding KindLabel}" Margin="0,0,0,4" Foreground="{StaticResource TextMutedBrush}" />
            <ComboBox x:Name="KindBox" MinHeight="36" Margin="0,0,0,8" />

            <Button x:Name="AddFileButton"
                    HorizontalAlignment="Right"
                    MinWidth="100"
                    MinHeight="36"
                    Margin="0,0,0,8"
                    Content="{Binding AddFileLabel}"
                    Click="AddFile_Click" />
            <ListBox x:Name="FileList" MinHeight="96" MaxHeight="160" Margin="0,0,0,12">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding Main, Mode=TwoWay}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0" />
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="StatusText"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"
                       Foreground="{StaticResource AccentAmberBrush}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Width="88"
                        MinHeight="36"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Content="{Binding CancelLabel}"
                        Click="Cancel_Click" />
                <Button x:Name="PublishButton"
                        MinWidth="140"
                        MinHeight="36"
                        Padding="12,8"
                        IsDefault="True"
                        Style="{StaticResource AccentButtonStyle}"
                        Content="{Binding PublishLabel}"
                        Click="Publish_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
