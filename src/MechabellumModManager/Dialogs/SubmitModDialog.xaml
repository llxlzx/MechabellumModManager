<Window x:Class="MechabellumModManager.Dialogs.SubmitModDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="投稿 Mod"
        SizeToContent="Height"
        Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgPanelBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}">
    <Border Padding="20"
            BorderBrush="{StaticResource SteelEdgeBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="DllLabel"
                       Grid.Row="0"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextMutedBrush}" />
            <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                <Button x:Name="PickButton"
                        DockPanel.Dock="Right"
                        Margin="8,0,0,0"
                        MinWidth="100"
                        Click="Pick_Click" />
                <TextBox x:Name="DllPathBox"
                         IsReadOnly="True"
                         VerticalAlignment="Center" />
            </DockPanel>

            <TextBlock x:Name="NameLabel"
                       Grid.Row="1"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextMutedBrush}" />
            <TextBox x:Name="NameBox"
                     Grid.Row="1"
                     Grid.Column="1"
                     Margin="0,0,0,8" />

            <TextBlock x:Name="AuthorLabel"
                       Grid.Row="2"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextMutedBrush}" />
            <TextBox x:Name="AuthorBox"
                     Grid.Row="2"
                     Grid.Column="1"
                     Margin="0,0,0,8" />

            <TextBlock x:Name="VersionLabel"
                       Grid.Row="3"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextMutedBrush}" />
            <TextBox x:Name="VersionBox"
                     Grid.Row="3"
                     Grid.Column="1"
                     Margin="0,0,0,8" />

            <TextBlock x:Name="SummaryLabel"
                       Grid.Row="4"
                       VerticalAlignment="Top"
                       Margin="0,6,0,0"
                       Foreground="{StaticResource TextMutedBrush}" />
            <TextBox x:Name="SummaryBox"
                     Grid.Row="4"
                     Grid.Column="1"
                     Height="72"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     Margin="0,0,0,8" />

            <StackPanel Grid.Row="6"
                        Grid.ColumnSpan="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,8,0,0">
                <Button x:Name="CancelButton"
                        Width="88"
                        Height="30"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Click="Cancel_Click" />
                <Button x:Name="OkButton"
                        Width="88"
                        Height="30"
                        IsDefault="True"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="Ok_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
