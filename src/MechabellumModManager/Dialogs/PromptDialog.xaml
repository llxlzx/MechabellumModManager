<Window x:Class="MechabellumModManager.Dialogs.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入"
        SizeToContent="Height"
        Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgPanelBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}">
    <Border Padding="20"
            BorderBrush="{StaticResource SteelEdgeBrush}"
            BorderThickness="1">
        <StackPanel>
            <TextBlock x:Name="PromptText"
                       Text="请输入"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"
                       Foreground="{StaticResource TextMutedBrush}" />
            <TextBox x:Name="InputBox"
                     Height="32"
                     Padding="8,6"
                     Background="{StaticResource BgElevatedBrush}"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     BorderBrush="{StaticResource SteelEdgeBrush}"
                     CaretBrush="{StaticResource AccentAmberBrush}"
                     FontSize="13" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0">
                <Button x:Name="CancelButton"
                        Width="88"
                        MinHeight="32"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Click="Cancel_Click" />
                <Button x:Name="OkButton"
                        Width="88"
                        MinHeight="32"
                        IsDefault="True"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="Ok_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
