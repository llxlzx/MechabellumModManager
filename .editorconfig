root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csproj,props,targets}]
indent_style = space
indent_size = 4

[*.{xaml,xml,resx,json,jsonc,yml,yaml,md}]
indent_style = space
indent_size = 2

[*.{cmd,bat,ps1}]
end_of_line = crlf

[*.sln]
end_of_line = crlf
