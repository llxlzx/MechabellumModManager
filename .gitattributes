# Normalize text; keep UTF-8 for localization-sensitive sources.
* text=auto eol=lf

*.cs text eol=lf working-tree-encoding=UTF-8
*.csproj text eol=lf working-tree-encoding=UTF-8
*.props text eol=lf working-tree-encoding=UTF-8
*.targets text eol=lf working-tree-encoding=UTF-8
*.xaml text eol=lf working-tree-encoding=UTF-8
*.resx text eol=lf working-tree-encoding=UTF-8
*.xml text eol=lf working-tree-encoding=UTF-8
*.json text eol=lf working-tree-encoding=UTF-8
*.jsonc text eol=lf working-tree-encoding=UTF-8
*.md text eol=lf working-tree-encoding=UTF-8
*.yml text eol=lf working-tree-encoding=UTF-8
*.yaml text eol=lf working-tree-encoding=UTF-8
*.txt text eol=lf working-tree-encoding=UTF-8
*.iss text eol=lf working-tree-encoding=UTF-8
*.ps1 text eol=lf working-tree-encoding=UTF-8
*.editorconfig text eol=lf working-tree-encoding=UTF-8
*.gitattributes text eol=lf working-tree-encoding=UTF-8
*.gitignore text eol=lf working-tree-encoding=UTF-8

*.sln text eol=crlf working-tree-encoding=UTF-8
*.cmd text eol=crlf working-tree-encoding=UTF-8
*.bat text eol=crlf working-tree-encoding=UTF-8

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.dll binary
*.exe binary
*.pdb binary
*.zip binary
*.7z binary
*.nupkg binary
