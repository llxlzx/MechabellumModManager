{
  "dotnet.defaultSolution": "MechabellumModManager.sln",
  "omnisharp.enableEditorConfigSupport": true,
  "omnisharp.enableRoslynAnalyzers": true,
  "files.encoding": "utf8",
  "files.autoGuessEncoding": true,
  "files.eol": "\n",
  "[csharp]": {
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false
  },
  "[xaml]": {
    "editor.formatOnSave": true,
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  "[json]": {
    "editor.tabSize": 2
  },
  "[jsonc]": {
    "editor.tabSize": 2
  },
  "[markdown]": {
    "editor.wordWrap": "on"
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/.worktrees/**": true,
    "**/.review-phase0-base-wt/**": true,
    "**/dist/**": true,
    "**/release/**": true,
    "**/publish/**": true,
    "**/packaging/installer/redist/**": true,
    "**/coscli_output/**": true,
    "**/bin/**": true,
    "**/obj/**": true,
    "**/.vs/**": true
  },
  "search.exclude": {
    "**/.worktrees": true,
    "**/.review-phase0-base-wt": true,
    "**/dist": true,
    "**/release": true,
    "**/publish": true,
    "**/packaging/installer/redist": true,
    "**/coscli_output": true,
    "**/bin": true,
    "**/obj": true,
    "**/.vs": true
  },
  "files.exclude": {
    "**/.worktrees": true,
    "**/.review-phase0-base-wt": true,
    "**/coscli_output": true
  }
}
